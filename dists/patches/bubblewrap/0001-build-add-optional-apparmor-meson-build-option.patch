From 0949a450614711cbe08ac02f168d5d5865bbaba7 Mon Sep 17 00:00:00 2001
From: Alexandre Pujol <alexandre@pujol.io>
Date: Mon, 9 Mar 2026 22:08:02 +0100
Subject: [PATCH 1/3] build: add optional apparmor meson build option.

Add apparmor meson feature  ption (default auto) for optional libapparmor support, following the same pattern as the existing SELinux option.

When found, HAVE_APPARMOR is set and libapparmor is linked.

Document --apparmor-profile in the man page.
---
 bwrap.xml         | 10 ++++++++++
 meson.build       | 12 +++++++++++-
 meson_options.txt |  6 ++++++
 tests/meson.build |  2 +-
 4 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/bwrap.xml b/bwrap.xml
index b48cf5b..aca8e56 100644
--- a/bwrap.xml
+++ b/bwrap.xml
@@ -527,6 +527,16 @@
 	the SELinux context for the sandbox content.
       </para></listitem>
     </varlistentry>
+    <varlistentry>
+      <term><option>--apparmor-profile <arg choice="plain">PROFILE</arg></option></term>
+      <listitem><para>
+	Use the specified AppArmor profile to confine the sandbox. The profile
+	transition is applied immediately via
+	<citerefentry><refentrytitle>aa_change_profile</refentrytitle><manvolnum>2</manvolnum></citerefentry>
+	before the sandboxed command is executed. The profile must already be
+	loaded into the kernel. Requires a kernel with AppArmor support.
+      </para></listitem>
+    </varlistentry>
     <varlistentry>
       <term><option>--block-fd <arg choice="plain">FD</arg></option></term>
       <listitem><para>
diff --git a/meson.build b/meson.build
index 7005e06..86c8089 100644
--- a/meson.build
+++ b/meson.build
@@ -74,6 +74,12 @@ selinux_dep = dependency(
   required : get_option('selinux'),
 )
 
+apparmor_dep = dependency(
+  'libapparmor',
+  # if disabled, Meson will behave as though libapparmor was not found
+  required : get_option('apparmor'),
+)
+
 cdata = configuration_data()
 cdata.set_quoted(
   'PACKAGE_STRING',
@@ -87,6 +93,10 @@ if selinux_dep.found()
   endif
 endif
 
+if apparmor_dep.found()
+  cdata.set('HAVE_APPARMOR', 1)
+endif
+
 if get_option('debug_logging')
   cdata.set('BWRAP_DEBUG', 1)
 endif
@@ -134,7 +144,7 @@ bwrap = executable(
   install : true,
   install_dir : bwrapdir,
   install_rpath : get_option('install_rpath'),
-  dependencies : [selinux_dep, libcap_dep],
+  dependencies : [selinux_dep, libcap_dep, apparmor_dep],
 )
 
 manpages_xsl = 'http://docbook.sourceforge.net/release/xsl/current/manpages/docbook.xsl'
diff --git a/meson_options.txt b/meson_options.txt
index f4f4ac7..a77c2d2 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -53,6 +53,12 @@ option(
   description : 'enable optional SELINUX support',
   value : 'auto',
 )
+option(
+  'apparmor',
+  type : 'feature',
+  description : 'enable optional AppArmor support',
+  value : 'auto',
+)
 option(
   'tests',
   type : 'boolean',
diff --git a/tests/meson.build b/tests/meson.build
index fe45af0..d947dd9 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -4,7 +4,7 @@ test_programs = [
     'test-utils.c',
     '../utils.c',
     '../utils.h',
-    dependencies : [selinux_dep],
+    dependencies : [selinux_dep, apparmor_dep],
     include_directories : common_include_directories,
   )],
 ]
-- 
