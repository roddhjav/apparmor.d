From 058ea404af47286fabe8e78f99ac89b53eaedd6f Mon Sep 17 00:00:00 2001
From: Alexandre Pujol <alexandre@pujol.io>
Date: Mon, 9 Mar 2026 22:23:01 +0100
Subject: [PATCH 2/3] Add --apparmor-profile option for sandbox confinement

Add --apparmor-profile option to confine the sandboxed program with an
AppArmor profile via aa_change_profile(2), applied late (right before
seccomp and execve) so that confinement targets the sandbox, not bwrap.

When HAVE_APPARMOR is defined, NNP is deferred past parse_args() since
aa_change_profile() requires NNP to not be set:

- Without --apparmor-profile: NNP is set after parse_args()
- With --apparmor-profile: NNP is set after aa_change_profile() in the
  child, and separately in the init process (PID 1)

Without HAVE_APPARMOR, NNP remains in its original position immediately
after acquire_privs().
---
 bubblewrap.c | 59 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 utils.c      | 16 ++++++++++++++
 utils.h      |  1 +
 3 files changed, 76 insertions(+)

diff --git a/bubblewrap.c b/bubblewrap.c
index 87da230..fe43c57 100644
--- a/bubblewrap.c
+++ b/bubblewrap.c
@@ -60,6 +60,9 @@ static const char *argv0;
 static const char *host_tty_dev;
 static const char *opt_exec_label = NULL;
 static const char *opt_file_label = NULL;
+#ifdef HAVE_APPARMOR
+static const char *opt_apparmor_profile = NULL;
+#endif
 static bool opt_as_pid_1;
 
 static const char *opt_argv0 = NULL;
@@ -358,6 +361,9 @@ usage (int ecode, FILE *out)
            "    --perms OCTAL                Set permissions of next argument (--bind-data, --file, etc.)\n"
            "    --size BYTES                 Set size of next argument (only for --tmpfs)\n"
            "    --chmod OCTAL PATH           Change permissions of PATH (must already exist)\n"
+#ifdef HAVE_APPARMOR
+           "    --apparmor-profile PROFILE   AppArmor profile for the sandbox\n"
+#endif
            "    --not-a-security-boundary    Do not fail hard when some sandbox setup steps fail;\n"
            "                                 use only when the sandbox is not a security boundary\n"
           );
@@ -610,6 +616,16 @@ do_init (int event_fd, pid_t initial_pid)
   /* Optionally bind our lifecycle to that of the caller */
   handle_die_with_parent ();
 
+#ifdef HAVE_APPARMOR
+  /* When --apparmor-profile is used, NNP was deferred in the parent.
+   * PID 1 doesn't need aa_change_profile, so set NNP here for seccomp. */
+  if (opt_apparmor_profile != NULL)
+    {
+      if (prctl (PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0)
+        die_with_error ("prctl(PR_SET_NO_NEW_PRIVS) failed");
+    }
+#endif
+
   seccomp_programs_apply ();
 
   while (true)
@@ -2112,6 +2128,21 @@ parse_args_recurse (int          *argcp,
           argv += 1;
           argc -= 1;
         }
+#ifdef HAVE_APPARMOR
+      else if (strcmp (arg, "--apparmor-profile") == 0)
+        {
+          if (argc < 2)
+            die ("--apparmor-profile takes an argument");
+
+          if (opt_apparmor_profile != NULL)
+            warn_only_last_option ("--apparmor-profile");
+
+          opt_apparmor_profile = argv[1];
+
+          argv += 1;
+          argc -= 1;
+        }
+#endif
       else if (strcmp (arg, "--dev") == 0)
         {
           if (argc < 2)
@@ -2925,9 +2956,11 @@ main (int    argc,
     bwrap_is_debugging = true;
 #endif
 
+#ifndef HAVE_APPARMOR
   /* Never gain any more privs during exec */
   if (prctl (PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0)
     die_with_error ("prctl(PR_SET_NO_NEW_PRIVS) failed");
+#endif
 
   /* The initial code is run with high permissions
      (i.e. CAP_SYS_ADMIN), so take lots of care. */
@@ -2947,6 +2980,16 @@ main (int    argc,
 
   parse_args (&argc, (const char ***) &argv);
 
+#ifdef HAVE_APPARMOR
+  /* When --apparmor-profile is used, NNP is deferred to the child
+   * after aa_change_profile(). Otherwise set it now. */
+  if (opt_apparmor_profile == NULL)
+    {
+      if (prctl (PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0)
+        die_with_error ("prctl(PR_SET_NO_NEW_PRIVS) failed");
+    }
+#endif
+
   /* suck the args into a cleanup_free variable to control their lifecycle */
   args_data = opt_args_data;
   opt_args_data = NULL;
@@ -3534,6 +3577,22 @@ main (int    argc,
 
   set_ambient_capabilities ();
 
+#ifdef HAVE_APPARMOR
+  /* Apply the AppArmor profile late, right before seccomp and execve(), so that
+   * the confinement targets the sandboxed program, not bwrap itself.
+   * aa_change_profile() requires NNP to not be set yet, so we set NNP
+   * immediately after. NNP must be set before seccomp_programs_apply() because
+   * SECCOMP_MODE_FILTER requires either NNP or CAP_SYS_ADMIN. */
+  if (opt_apparmor_profile != NULL)
+    {
+      if (apparmor_change_profile (opt_apparmor_profile) != 0)
+        die_with_error ("apparmor_change_profile %s", opt_apparmor_profile);
+
+      if (prctl (PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0)
+        die_with_error ("prctl(PR_SET_NO_NEW_PRIVS) failed");
+    }
+#endif
+
   /* Should be the last thing before execve() so that filters don't
    * need to handle anything above */
   seccomp_programs_apply ();
diff --git a/utils.c b/utils.c
index 5865cdb..a57a187 100644
--- a/utils.c
+++ b/utils.c
@@ -27,6 +27,9 @@
 #ifdef HAVE_SELINUX
 #include <selinux/selinux.h>
 #endif
+#ifdef HAVE_APPARMOR
+#include <sys/apparmor.h>
+#endif
 
 #ifndef __NR_pivot_root
 #error Linux kernel headers with __NR_pivot_root are required
@@ -953,6 +956,19 @@ label_exec (UNUSED const char *exec_label)
   return 0;
 }
 
+int
+apparmor_change_profile (UNUSED const char *profile)
+{
+#ifdef HAVE_APPARMOR
+  if (profile == NULL)
+    return 0;
+
+  return aa_change_profile (profile);
+#else
+  return 0;
+#endif
+}
+
 /*
  * Like strerror(), but specialized for a failed mount(2) call.
  */
diff --git a/utils.h b/utils.h
index 0872223..e5de8c1 100644
--- a/utils.h
+++ b/utils.h
@@ -157,6 +157,7 @@ char *label_mount (const char *opt,
                    const char *mount_label);
 int   label_exec (const char *exec_label);
 int   label_create_file (const char *file_label);
+int   apparmor_change_profile (const char *profile);
 
 extern bool opt_force_openat_fallback;
 extern bool opt_force_mount_setattr_fallback;
-- 
2.55.0

