[Application]
name=com.valvesoftware.Steam
runtime=org.freedesktop.Platform/x86_64/25.08
sdk=org.freedesktop.Sdk/x86_64/25.08
tags=proprietary;
command=steam
required-flatpak=1.12.0

[Context]
shared=network;ipc;
sockets=x11;wayland;pulseaudio;
devices=all;
features=devel;multiarch;bluetooth;per-app-dev-shm;
filesystems=xdg-config/MangoHud:ro;/mnt;xdg-pictures:ro;xdg-run/app/com.discordapp.Discord:create;/run/udev:ro;xdg-run/speech-dispatcher:ro;/run/media;xdg-music:ro;/media;xdg-run/pipewire-0:ro;
persistent=.;
unset-environment=ALSA_CONFIG_PATH;TZ;STEAM_RUNTIME_PREFER_HOST_LIBRARIES;STEAM_RUNTIME;MESA_GLSL_CACHE_DIR;SDL_VIDEODRIVER;

[Session Bus Policy]
com.steampowered.*=own
org.kde.StatusNotifierWatcher=talk
org.freedesktop.Notifications=talk
org.freedesktop.ScreenSaver=talk
org.freedesktop.PowerManagement=talk
org.gnome.SessionManager=talk

[System Bus Policy]
org.freedesktop.UPower=talk
org.freedesktop.UDisks2=talk

[Environment]
ALSA_CONFIG_PATH=
TZ=
PYTHONPATH=/app/utils/lib/python3.13/site-packages
LC_NUMERIC=C
XDG_DATA_DIRS=/app/share:/usr/lib/extensions/vulkan/share:/usr/share:/usr/share/runtime/share:/run/host/user-share:/run/host/share:/usr/lib/pressure-vessel/overrides/share
LC_MONETARY=C
FLATPAK_STEAM_UPDATE_SYMLINKS=0
DBUS_FATAL_WARNINGS=0
STEAM_RUNTIME_PREFER_HOST_LIBRARIES=
FLATPAK_STEAM_XDG_DIRS_PREFIX=~/.var/app/com.valvesoftware.Steam
LC_TELEPHONE=C
SSL_CERT_DIR=/etc/ssl/certs
LC_MEASUREMENT=C
STEAM_RUNTIME=
LC_COLLATE=C
LC_NAME=C
XDG_CONFIG_DIRS=/etc/xdg:/usr/lib/x86_64-linux-gnu/GL:/usr/lib/i386-linux-gnu/GL
MESA_GLSL_CACHE_DIR=
SDL_VIDEODRIVER=
GST_PLUGIN_SYSTEM_PATH=/app/lib/gstreamer-1.0:/app/lib32/gstreamer-1.0:/usr/lib/extensions/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/codecs-extra/lib/gstreamer-1.0:/usr/lib/i386-linux-gnu/codecs-extra/lib/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/gstreamer-1.0:/usr/lib/i386-linux-gnu/gstreamer-1.0
PATH=/app/bin:/app/utils/bin:/usr/bin
LC_ADDRESS=C
STEAM_EXTRA_COMPAT_TOOLS_PATHS=/app/share/steam/compatibilitytools.d:/app/utils/share/steam/compatibilitytools.d
PROTON_DEBUG_DIR=/var/tmp

[Extension com.valvesoftware.Steam.CompatibilityTool]
directory=share/steam/compatibilitytools.d
autodelete=true
no-autodownload=true
subdirectories=true
version=stable
versions=stable;beta;test

[Extension com.valvesoftware.Steam.Utility]
directory=utils
autodelete=true
no-autodownload=true
subdirectories=true
add-ld-path=lib
merge-dirs=bin;lib/python3.13/site-packages;share/vulkan/explicit_layer.d;share/vulkan/implicit_layer.d;share/steam/compatibilitytools.d;
version=stable
versions=stable;beta;test

[Extension org.freedesktop.Platform.Compat.i386]
directory=lib/i386-linux-gnu
version=25.08

[Extension org.freedesktop.Platform.Compat.i386.Debug]
directory=lib/debug/lib/i386-linux-gnu
no-autodownload=true
version=25.08

[Extension org.freedesktop.Platform.GL32]
directory=lib/i386-linux-gnu/GL
no-autodownload=true
subdirectories=true
add-ld-path=lib
download-if=active-gl-driver
enable-if=active-gl-driver
autoprune-unless=active-gl-driver
merge-dirs=vulkan/icd.d;glvnd/egl_vendor.d;egl/egl_external_platform.d;OpenCL/vendors;lib/dri;lib/d3d;lib/gbm;vulkan/explicit_layer.d;vulkan/implicit_layer.d;vdpau
version=1.4
versions=25.08;25.08-extra;1.4

[Extension org.freedesktop.Platform.GL32.Debug]
directory=lib/debug/lib/i386-linux-gnu/GL
no-autodownload=true
subdirectories=true
enable-if=active-gl-driver
autoprune-unless=active-gl-driver
merge-dirs=vulkan/icd.d;glvnd/egl_vendor.d;egl/egl_external_platform.d;OpenCL/vendors;lib/dri;lib/d3d;lib/gbm;vulkan/explicit_layer.d;vulkan/implicit_layer.d;vdpau
version=1.4
versions=25.08;25.08-extra;1.4

[Extension org.freedesktop.Platform.VAAPI.Intel.i386]
directory=lib/i386-linux-gnu/dri/intel-vaapi-driver
no-autodownload=true
add-ld-path=lib
download-if=have-intel-gpu
autoprune-unless=have-intel-gpu
version=25.08
versions=25.08

[Extension org.freedesktop.Platform.VAAPI.nvidia.i386]
directory=i386/nvidia-vaapi-driver
no-autodownload=true
add-ld-path=lib
download-if=have-kernel-module-nvidia
autoprune-unless=have-kernel-module-nvidia
version=25.08
versions=25.08

[Extension org.freedesktop.Platform.codecs_extra.i386]
directory=lib/i386-linux-gnu/codecs-extra
add-ld-path=lib
version=25.08-extra

[Extension com.valvesoftware.Steam.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=com.valvesoftware.Steam.Debug;com.valvesoftware.Steam.Sources;
