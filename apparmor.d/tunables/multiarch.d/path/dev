# Define commonly used developer program names and paths.

# It is mostly used to easily define folder access in development tools profiles,
# not to allow execution.
#
# !!! warning
#
#     Sensitive tools like git/ssh/gpg should not be included in `@{devtools}`.
#     This should only contains core development tools like compilers, analysis tools, linters, debuggers etc.
#
@{devtools_name}  = ansible cargo dlv gem go just node npm pip pyright python ruby
@{devtools_name} += rust typescript yarn docker uv pytest ruby tex electron ImageMagick

@{devtools} = @{devtools_name}

include if exists <tunables/path/dev.d>

# vim:syntax=apparmor
