abi <abi/5.0>,

include <tunables/global>

@{name} = Bitwarden
@{domain} = org.chromium.Chromium
@{lib_dirs} = @{lib}/bitwarden
@{config_dirs} = @{user_config_dirs}/@{name}
@{cache_dirs} = @{user_cache_dirs}/@{name} @{user_cache_dirs}/com.bitwarden.desktop

@{exec_path} = @{bin}/bitwarden-desktop
profile bitwarden @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/common/electron>
  include <abstractions/devices-u2f>
  include <abstractions/user-download-strict>

  capability dac_override,

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  @{exec_path} mrix,

  @{bin}/dbus-send rix,
  @{bin}/xprop     rix,

  @{open_path}                          Px -> child-open-browsers,
  @{lib}/glycin-loaders/@{d}+/glycin-*  Px -> :glycin:loaders,

  owner @{HOME}/.bitwarden-ssh-agent.sock w,

        @{PROC}/@{pid}/ r,
        @{PROC}/@{pid}/cgroup r,
        @{PROC}/@{pid}/fd/ r,
        @{PROC}/@{pid}/statm r,

  include if exists <local/bitwarden>
}

# vim:syntax=apparmor
