abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/chafa
profile chafa @{exec_path} {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/fonts>
  include <abstractions/user-read-strict>

  @{exec_path} mr,

  include if exists <local/chafa>
}

# vim:syntax=apparmor
