abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{sbin}/dkms
profile dkms @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/cgroup-limits>
  include <abstractions/consoles>
  include <abstractions/nameservice-strict>

  capability dac_override,
  capability dac_read_search,
  capability mknod,
  capability setgid,
  capability setuid,

  ptrace read peer=@{p_systemd},

  @{exec_path} rm,

  @{sh_path}       mr,
  @{coreutils_path} rix,

  @{bin}/getopt      rix,
  @{bin}/kmod        rCx -> kmod,
  @{bin}/kmodsign   mrix,
  @{bin}/llvm-objcopy Cx -> build,
  @{bin}/make         Cx -> build,
  @{bin}/openssl     rix,
  @{bin}/patch      mrCx -> build,
  @{bin}/rpm          PUx,
  @{bin}/xz          rix,
  @{bin}/zstd        rix,

  @{bin}/{,@{multiarch}}readelf rix,
  @{bin}/{,@{multiarch}}strip   rix,
  #aa:only apt
  @{sbin}/update-secureboot-policy rPx,

  #aa:only opensuse
  @{bin}/systemctl Cx -> systemctl, # updating on openSUSE via dkms.service

  @{lib}/module-init-tools/weak-modules2   rix,
  @{lib}/modules/*/build/scripts/sign-file rix,

  /var/lib/dkms/*/*/build/** Cx -> build,
  /usr/src/linux-*/*/*/scripts/sign-file rix,
  /usr/src/*/dkms.@{word} Cx -> build,

  @{lib}/modules/*/build/** r,
  @{lib}/modules/*/initrd/ w,
  @{lib}/modules/*/kernel/drivers/{,*,*/,**.ko.xz,**.ko.zst} r,
  @{lib}/modules/*/updates/ rw,
  @{lib}/modules/*/updates/{,dkms/}{,*,*/,**.ko.xz,**.ko.zst} rw,
  #aa:only ubuntu
  @{lib}/modules/*/ubuntu/dkms/**.ko.zst rw,

  /etc/dkms/{,**} r,
  /etc/lsb-release r,
  /etc/sysconfig/bootloader r,

  /var/{,lib/} r,
  /var/lib/dkms/ r,
  /var/lib/dkms/*/{,**} rw,
  /var/lib/dkms/mok.key rw,
  /var/lib/dkms/mok.pub rw,
  /var/lib/shim-signed/mok/* r,

  audit /var/lib/rpm/ r,
  audit /var/lib/rpm/** rw,

  /var/tmp/weak-modules2.@{rand6}/ rw,

  / r,

  /usr/src/{,**} r,

  @{sys}/devices/{,**/} r,
  @{sys}/devices/**/modalias r,
  @{sys}/fs/cgroup/system.slice/cpu.max r,
  @{sys}/fs/cgroup/system.slice/dkms.service/cpu.max r,

  owner @{tmp}/tmp.@{rand10} rw,
  audit owner @{tmp}/dkms.*/ rw,
  audit owner @{tmp}/sh-thd.* rw,

  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/fd/ r,
  @{PROC}/@{pid}/mountinfo r,
  audit @{PROC}/sys/kernel/osrelease r,

  /dev/pts/@{u16} rw,

  # Silencers
  deny @{HOME}/{,**} r,

  profile build {
    include <abstractions/base>
    include <abstractions/cgroup-limits>
    include <abstractions/consoles>
    include <abstractions/nameservice-strict>
    include <abstractions/perl>
    include <abstractions/python>

    capability dac_read_search,
    capability sys_admin, # optional: no audit

    @{sh_path}        rix,
    @{archive_path}   rix,
    @{coreutils_path} rix,
    @{ldd_path}       rix,
    @{python_path}    rix,

    @{bin}/* mrix,
    @{lib}/gcc/@{multiarch}/@{version}/* rix,
    @{lib}/getconf/getconf               rix,
    @{lib}/llvm-@{d}*/bin/clang          rix,

    # Execs included with the kernel headers
    #aa:only debian
    @{lib}/linux-kbuild-*/scripts/** rix,
    @{lib}/linux-kbuild-*/tools/**   rix,

    #aa:only arch
    @{lib}/modules/*/build/scripts/** rix,
    @{lib}/modules/*/build/tools/**   rix,

    #aa:only opensuse
    /usr/src/linux-*/*/*/scripts/** rix,
    /usr/src/linux-*/*/*/tools/**   rix,

    #aa:only ubuntu
    /usr/src/linux-*/scripts/** mrix,
    /usr/src/linux-*/tools/**   mrix,

    # Execs included with the dkms modules
    /var/lib/dkms/*/*/build/** rix,

    /usr/ r,
    /usr/share/doc/go/ r,
    /usr/share/file/misc/magic.mgc r,
    /usr/share/gettext{,-@{version}}/its/{,**.loc} r,
    /usr/share/libalternatives/{,**} r,
    /usr/share/pkgconfig/{,*} r,
    /usr/share/terminfo/{,**} r,

    /etc/magic r,
    #aa:only ubuntu
    /etc/dpkg/origins/ubuntu r,

    / r,
    /opt/ r,
    /usr/local/{,lib/} r,
    @{lib}/ r,
    @{lib}/os-release r,

    /var/lib/dkms/*/*/build/ r,
    /var/lib/dkms/*/*/build/** rwk,
    # ZFS specific
    /var/lib/dkms/*/*/*/@{arch}/* w,

    /usr/{,local/}include/ r,
    /usr/{,local/}include/**.h r,
    /usr/src/linux-*/{,**}  r,
    /usr/src/*/dkms.@{word} r,

    @{tmp}/@{word8}{,/} rw,
    @{tmp}/@{word8}/dummy.c rw,
    @{tmp}/cc@{rand6}* rw,
    @{tmp}/GMfifo@{int} rw,

    @{PROC}/@{pids}/cgroup r,
    @{PROC}/@{pids}/fd/ r,
    @{PROC}/@{pids}/maps r,
    @{PROC}/@{pids}/statm r,

    # Silencers
    deny network inet dgram,
    deny network inet6 dgram,
    deny @{HOME}/{,**} r,

    include if exists <local/dkms_build>
  }

  profile kmod {
    include <abstractions/base>
    include <abstractions/app/kmod>

    @{lib}/modules/*/modules.* rw,
    /var/lib/dkms/**/module/*.ko* r,

    owner @{efi}/System.map-* r,

    owner @{tmp}/tmp.@{rand10} r,

    @{sys}/module/compression r,
    @{sys}/module/*/initstate r,

    include if exists <local/dkms_kmod>
  }

  profile systemctl {
    include <abstractions/base>
    include <abstractions/app/systemctl>

    capability net_admin,
    capability sys_resource,

    signal send set=term peer=systemd-tty-ask-password-agent,

    @{bin}/systemd-tty-ask-password-agent Px,

    include if exists <local/dkms_systemctl>
  }

  include if exists <local/dkms>
}

# vim:syntax=apparmor
