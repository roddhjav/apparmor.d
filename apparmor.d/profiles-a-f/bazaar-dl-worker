abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/bazaar-dl-worker
profile bazaar-dl-worker @{exec_path} {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/bus-system>
  include <abstractions/bus/session/org.gtk.vfs.MountTracker>
  include <abstractions/dconf-write>
  include <abstractions/gschemas>
  include <abstractions/nameservice-strict>
  include <abstractions/network-manager-observe>
  include <abstractions/p11-kit>
  include <abstractions/ssl_certs>

  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,
  network netlink raw,

  signal receive set=kill peer=bazaar,

  @{exec_path} mr,

  owner @{user_cache_dirs}/io.github.kolunmi.Bazaar/{,**} rw,

  include if exists <local/bazaar-dl-worker>
}

# vim:syntax=apparmor
