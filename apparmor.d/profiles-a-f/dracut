abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/dracut
profile dracut @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/disks-read>
  include <abstractions/nameservice-strict>
  include <abstractions/path>

  capability dac_override,
  capability mknod,
  capability sys_chroot,

  network alg seqpacket, # kernel crypto API

  @{exec_path} mrix,

  @{sh_path}                  rix,
  @{archive_path}             rix,
  @{coreutils_path}           rix,
  @{ldd_path}                  Cx -> ldd,
  @{bin}/@{multiarch}-pkg-config rix,
  @{bin}/3cpio                rix,
  @{bin}/eu-strip             rix,
  @{bin}/logger rix,
  @{bin}/findmnt               Px,
  @{bin}/getopt               rix,
  @{bin}/hardlink             rix,
  @{bin}/kmod                  Cx -> kmod,
  @{bin}/mountpoint           rix,
  @{bin}/pkgconf              rix,
  @{bin}/sync                 rix,
  @{bin}/systemctl             Cx -> systemctl,
  @{bin}/systemd-cat           Px,
  @{bin}/systemd-detect-virt   Px,
  @{bin}/systemd-escape        Px,
  @{bin}/udevadm               Px,
  @{bin}/zgrep                rix,
  @{sbin}/blkid                Px,
  @{sbin}/btrfs                Px,
  @{sbin}/ldconfig            rix,
  @{lib}/plymouth/plymouth-populate-initrd PUx,

  @{lib}/dracut/dracut-util    rix,
  @{lib}/dracut/dracut-install Px,

  @{lib}/ r,
  @{lib}/dracut/{,**} r,

  /usr/share/kbd/{,**} r,
  /usr/share/pkgconfig/{,**} r,
  /usr/share/plymouth/{,**} r,
  /usr/share/terminfo/{,**} r,

  /etc/depmod.d/ r,
  /etc/depmod.d/*.conf r,
  /etc/dracut.conf r,
  /etc/dracut.conf.d/{,**} r,
  /etc/machine-id r,
  /etc/modprobe.d/{,**} r,
  @{lib}/modprobe.d/{,**} r,

  /etc/crypttab r,
  /etc/fstab r,
  /etc/modules-load.d/{,**} r,
  /etc/plymouth/plymouthd.conf r,
  /etc/shadow r,
  /etc/sysconfig/{,**} r,
  /etc/systemd/{,**} r,
  /etc/vconsole.conf r,

  @{efi}/initrd* rw,

  /var/lib/bluetooth/{,**/} r,

  /var/tmp/dracut.@{rand6}/{,**} rwl,
  /var/tmp/dracut.@{rand6}@{w}/{,**} rwl,

  @{run}/modprobe.d/ r,
  @{run}/modprobe.d/*.conf r,

  @{sys}/bus/*/devices/ r,
  @{sys}/devices/**/modalias r,
  @{sys}/module/firmware_class/parameters/path r,

  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/fd/ r,
  @{PROC}/@{pid}/mountinfo r,
  @{PROC}/cmdline r,
  @{PROC}/swaps r,

  profile systemctl {
    include <abstractions/base>
    include <abstractions/app/systemctl>

    capability net_admin,

    /var/tmp/dracut.@{rand6}/{,**} rw,

    include if exists <local/dracut_systemctl>
  }

  profile kmod {
    include <abstractions/base>
    include <abstractions/app/kmod>

    /var/tmp/dracut.@{rand6}/initramfs/@{lib}/modules/*/ r,
    /var/tmp/dracut.@{rand6}/initramfs/@{lib}/modules/*/kernel/{,**} r,
    /var/tmp/dracut.@{rand6}/modules/*/ r,
    /var/tmp/dracut.@{rand6}/modules/*/kernel/{,**} r,

    @{sys}/module/compression r,
    @{sys}/module/**/initstate r,

    include if exists <local/dracut_kmod>
  }

  profile ldd {
    include <abstractions/base>
    include <abstractions/consoles>
    include <abstractions/nameservice-strict>

    @{ldd_path}  mrix,

    @{bin}/* mr,
    @{sbin}/* mr,
    @{lib}/**  mr,

    include if exists <local/dracut_ldd>
  }

  include if exists <local/dracut>
}

# vim:syntax=apparmor
