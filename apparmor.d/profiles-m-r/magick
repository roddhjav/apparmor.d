abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/magick
profile magick @{exec_path} {
  include <abstractions/base>
  include <abstractions/fonts>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  @{sh_path}       rix,
  @{bin}/gs{,.bin} rix,

  /etc/ImageMagick-@{int}/** r,
  /etc/paperspecs r,

  /usr/share/color/icc/ghostscript/* r,
  /usr/share/ghostscript/{,**} r,
  /usr/share/ImageMagick-@{int}/** r,

  # Allow access to all image files in user directories
  @{user_dirs}/@{image_files} rw,

  # Allow access to pdf files
  @{user_dirs}/[^.]*.[pP][dD][fF] rw,

  owner @{tmp}/magick-* rw,

  include if exists <local/magick>
}

# vim:syntax=apparmor
