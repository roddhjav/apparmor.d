abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/reprepro
profile reprepro @{exec_path} {
  include <abstractions/base>
  include <abstractions/consoles>

  @{exec_path} mr,

  @{bin}/gpgconf rCx -> gpg,
  @{bin}/gpg{,2} rCx -> gpg,
  @{bin}/gpgsm   rCx -> gpg,
  @{bin}/zstd    ix,

  /var/cache/apt/archives/*.deb r,

  owner @{user_projects_dirs}/** rw,
  owner @{user_build_dirs}/** rw,

  owner @{user_pkg_dirs}/ rw,
  owner @{user_pkg_dirs}/** rwlk,

  owner @{PROC}/@{pid}/fd/ r,

  #aa:only test
  /tmp/@{rand10}/** rwlk,

  profile gpg {
    include <abstractions/base>

    @{bin}/gpgconf mr,
    @{bin}/gpg{,2} mr,
    @{bin}/gpgsm mr,

    owner @{user_gpg_dirs}/ rw,
    owner @{user_gpg_dirs}/** rwlk -> @{user_gpg_dirs}/**,

    owner @{run}/user/@{uid}/gnupg/S.gpg-agent rw,

    include if exists <local/reprepro_gpg>
  }

  include if exists <local/reprepro>
}

# vim:syntax=apparmor
