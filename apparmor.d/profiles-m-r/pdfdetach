abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/pdfdetach
profile pdfdetach @{exec_path} {
  include <abstractions/base>

  @{exec_path} mr,

  /usr/share/poppler/{,**} r,

  @{user_dirs}/[^.]*.[pP][dD][fF] r,
  owner @{user_dirs}/[^.]*.[pP][dD][fF] rw,
  owner @{user_dirs}/@{archive_files} w,
  owner @{user_dirs}/@{document_files} w,
  owner @{user_dirs}/@{multimedia_files} w,
  owner @{user_dirs}/@{text_files} w,

  include if exists <local/pdfdetach>
}

# vim:syntax=apparmor
