abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/mokutil
profile mokutil @{exec_path} {
  include <abstractions/base>

  capability sys_admin,

  @{exec_path} mr,

  /var/lib/shim-signed/mok/MOK.der r,

  @{sys}/firmware@{efi}/mok-variables/MokList* r,

  @{PROC}/keys r,

  include if exists <local/mokutil>
}

# vim:syntax=apparmor
