abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/obamenu
profile obamenu @{exec_path} {
  include <abstractions/base>
  include <abstractions/desktop-files>
  include <abstractions/python>

  @{exec_path} r,
  @{python_path} rix,

  /usr/share/pixmaps/{,**} r,

  include if exists <local/obamenu>
}

# vim:syntax=apparmor
