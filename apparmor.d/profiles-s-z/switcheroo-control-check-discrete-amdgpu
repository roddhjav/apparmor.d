abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/switcheroo-control-check-discrete-amdgpu
profile switcheroo-control-check-discrete-amdgpu @{exec_path} {
  include <abstractions/base>
  include <abstractions/dri>

  capability sys_admin,

  @{exec_path} mr,

  /usr/share/libdrm/*.ids r,

  include if exists <local/switcheroo-control-check-discrete-amdgpu>
}

# vim:syntax=apparmor
