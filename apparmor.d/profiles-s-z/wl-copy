abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/wl-copy
profile wl-copy @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/mime>
  include <abstractions/wayland-strict>

  @{exec_path} mr,

  @{bin}/cat rix,

  owner @{tmp}/wl-copy-buffer-@{rand6}/ rw,
  owner @{tmp}/wl-copy-buffer-@{rand6}/@{int} rw,

  include if exists <local/wl-copy>
}

# vim:syntax=apparmor
