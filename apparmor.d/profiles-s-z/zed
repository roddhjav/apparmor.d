abi <abi/5.0>,

include <tunables/global>

@{exec_path} = /{usr/,}{local/,}{s,}bin/zed
profile zed @{exec_path} {
  include <abstractions/base>
  include <abstractions/disks-read>

  capability sys_admin,

  network netlink raw,

  @{exec_path} mr,

  @{bin}/{m,g,}awk rix,
  @{bin}/basename rix,
  @{bin}/cat rix,
  @{bin}/diff rix,
  @{bin}/expr rix,
  @{bin}/flock rix,
  @{bin}/{,e}grep rix,
  @{bin}/hostname rix,
  @{bin}/logger rix,
  @{bin}/ls rix,
  @{bin}/mktemp rix,
  @{bin}/realpath rix,
  @{bin}/rm rix,
  @{bin}/sort rix,

  @{bin}/zfs    rPx,
  @{sbin}/zpool rPx,
  @{lib}/zfs{,-linux}/zed.d/*.sh rix,

  /etc/zfs/zed.d/{,*} r,
  /etc/zfs/zfs-list.cache/{,*} rwk,

  @{run}/zed.pid rwlk,
  @{run}/zed.state rwlk,
  @{run}/zfs-list.cache@* rw,

  owner @{tmp}/tmp.* rw,

  @{sys}/bus/pci/slots/ r,
  @{sys}/bus/pci/slots/@{int}-@{int}/address r,
  @{sys}/bus/pci/slots/@{int}/address r,
  @{sys}/devices/@{pci}/uevent r,
  @{sys}/devices/@{pci_bus}/uevent r,
  @{sys}/module/zfs/*/ r,
  @{sys}/module/zfs/parameters/zfs_zevent_len_max rw,

        @{PROC}/@{pids}/mounts r,
        @{PROC}/@{pid}/task/@{tid}/comm rw,
  owner @{PROC}/@{pids}/fd/ r,

  /dev/zfs rw,

  include if exists <local/zed>
}

# vim:syntax=apparmor
