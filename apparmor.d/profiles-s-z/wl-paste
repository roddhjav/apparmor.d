abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/wl-paste
profile wl-paste @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/mime>
  include <abstractions/wayland-strict>

  @{exec_path} mr,

  @{bin}/cat rix,

  include if exists <local/wl-paste>
}

# vim:syntax=apparmor
