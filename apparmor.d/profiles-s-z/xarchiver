abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/xarchiver
profile xarchiver @{exec_path} {
  include <abstractions/base>
  include <abstractions/dconf-write>
  include <abstractions/desktop>
  include <abstractions/nameservice-strict>
  include <abstractions/cgroup-limits>
  include <abstractions/consoles>
  include <abstractions/thumbnails-cache-read>
  include <abstractions/user-download-strict>

  @{exec_path} mrix,

  @{sh_path}           rix,
  @{bin}/ls            rix,
  @{bin}/rm            rix,
  @{bin}/mv            rix,
  @{bin}/cp            rix,

  # Archivers
  @{archive_path}      rix,
  @{bin}/{,@{multiarch}-}ar rix,

  @{open_path}         rPx -> child-open,

  /etc/fstab r,

  @{user_dirs}/ rw,
  owner @{user_dirs}/@{archive_files} rw,
  @{user_dirs}/@{document_files} w,
  @{user_dirs}/@{multimedia_files} w,
  @{user_dirs}/@{text_files} w,
  @{user_dirs}/@{archive_files} r,

  owner /tmp/@{archive_files} rw,
  owner /tmp/xa-@{rand6}/{,**} rw,
  /tmp/@{archive_files} r,

        @{PROC}/@{pid}/mountinfo r,
        @{PROC}/@{pid}/mounts r,
  owner @{PROC}/@{pid}/fd/ r,

  owner /dev/tty@{u8} rw,

  include if exists <local/xarchiver>
}

# vim:syntax=apparmor
