# Can query UPower for power devices, history and statistics and set preferences

  abi <abi/5.0>,

  include <abstractions/upower-observe>

  dbus send bus=system path=/org/freedesktop/UPower/KbdBacklight
       interface=org.freedesktop.UPower.KbdBacklight
       member=SetBrightness
       peer=(name=@{busname}, label=upowerd),

  include if exists <abstractions/upower-control.d>

# vim:syntax=apparmor
