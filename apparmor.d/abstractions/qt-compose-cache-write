# Allow writing cache for Qt6 "platforminputcontexts" plugins

  abi <abi/5.0>,

  owner @{user_cache_dirs}/#@{int} rw,  # QSaveFile (anonymous shared memory)
  owner @{user_cache_dirs}/qt_compose_cache_little_endian_* rwl, # -> @{user_cache_dirs}/#@{int},
  owner @{user_cache_dirs}/qt_compose_cache_big_endian_* rwl, # -> @{user_cache_dirs}/#@{int},

  include if exists <abstractions/qt-compose-cache-write.d>

