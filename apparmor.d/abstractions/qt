# Common rules for Qt5-based applications

  abi <abi/5.0>,

  /usr/share/qt{,5,6}/qtlogging.ini r,
  /usr/share/qt{,5,6}/resources/*.pak r,
  /usr/share/qt{,5,6}/translations/*.qm r,
  /usr/share/qt{,5,6}/translations/qtwebengine_locales/*.pak r,
  /usr/share/qt{,5,6}ct/{,**} r,

  /etc/xdg/QtProject/qtlogging.ini r,

  owner @{user_config_dirs}/QtProject/qtlogging.ini r,
  owner @{user_config_dirs}/QtProject.conf r,
  owner @{user_config_dirs}/qt{,5,6}ct/{,**} r,

  # For "platforminputcontexts" plugins
  owner @{user_cache_dirs}/qt_compose_cache_big_endian_* r,
  owner @{user_cache_dirs}/qt_compose_cache_little_endian_* r,

  include if exists <abstractions/qt.d>

# vim:syntax=apparmor
