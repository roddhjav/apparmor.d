#aa:lint ignore=dangerous-exec

  abi <abi/5.0>,

  include <abstractions/path>

  priority=-10 @{bin}/**                     PUx,
  priority=-10 @{lib}/**                     PUx,
  priority=-10 /opt/*/**                     PUx,
  priority=-10 /usr/local/bin/**             PUx,
  priority=-10 /usr/share/**                 PUx,

  priority=-10 owner @{user_bin_dirs}/**     PUx,

  # Labeled programs
  @{archive_viewers_path}   PUx,
  @{backup_path}            PUx,
  @{browsers_path}          Px,
  @{document_viewers_path}  PUx,
  @{emails_path}            PUx,
  @{file_explorers_path}    Px,
  @{help_path}              Px,
  @{image_viewers_path}     PUx,
  @{offices_path}           PUx,
  @{terminal_path}          PUx,
  @{text_editors_path}      PUx,
  @{thunderbird_path}       Px,

  include if exists <abstractions/app-launcher-user.d>

# vim:syntax=apparmor
