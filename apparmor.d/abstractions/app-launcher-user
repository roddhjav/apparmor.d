#aa:lint ignore=dangerous-exec

  abi <abi/5.0>,

  include <abstractions/path>

  priority=-1 @{bin}/**                 PUx,
  priority=-1 @{lib}/**                 PUx,
  priority=-1 /opt/*/**                 PUx,
  priority=-1 /usr/local/bin/**         PUx,
  priority=-1 /usr/share/**             PUx,

  priority=-1 owner @{user_bin_dirs}/** PUx,

  # Labeled programs
  @{archive_viewers_path}   PUx,
  @{backup_path}            PUx,
  @{document_viewers_path}  PUx,
  @{emails_path}            PUx,
  @{image_viewers_path}     PUx,
  @{offices_path}           PUx,
  @{terminal_path}          PUx,
  @{text_editors_path}      PUx,
  priority=10 @{browsers_path}          Px,
  priority=10 @{file_explorers_path}    Px,
  priority=10 @{help_path}              Px,
  priority=10 @{thunderbird_path}       Px,

  include if exists <abstractions/app-launcher-user.d>

# vim:syntax=apparmor
