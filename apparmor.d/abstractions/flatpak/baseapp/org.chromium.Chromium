# apparmor.d - Full set of apparmor profiles
# Copyright (C) 2025-2026 Alexandre Pujol <alexandre@pujol.io>
# SPDX-License-Identifier: GPL-2.0-only
# LOGPROF-SUGGEST: no
# NEEDS-VARIABLE: appid
# NEEDS-VARIABLE: profile_app

  abi <abi/5.0>,

  include <abstractions/nss>

  unix (send receive) type=seqpacket peer=(label=@{profile_app}//crashpad_handler),

        /dev/shm/ r,
  owner /dev/shm/.@{appid}.@{rand6} rw,
  owner /dev/shm/.org.chromium.Chromium.@{rand6} rw,

  @{sys}/devices/**/usb@{int}/{,*/}bConfigurationValue r,
  @{sys}/devices/**/usb@{int}/{,*/}descriptors r,
  @{sys}/devices/**/usb@{int}/{,*/}manufacturer r,
  @{sys}/devices/**/usb@{int}/{,*/}product r,
  @{sys}/devices/**/usb@{int}/{,*/}serial r,
  @{sys}/devices/**/usb@{int}/{,*/}vendor r,

  @{sys}/devices/system/cpu/cpu@{int}/microcode/version r,
  @{sys}/devices/system/cpu/kernel_max r,

  # Allow getting the manufacturer and model of the computer where chromium is currently running.
  @{sys}/devices/virtual/dmi/id/product_name r,
  @{sys}/devices/virtual/dmi/id/sys_vendor r,

  # Pressure Stall Information interface
  @{PROC}/pressure/cpu r,
  @{PROC}/pressure/io r,
  @{PROC}/pressure/memory r,

  # Chromium content api unfortunately needs these for normal operation
  owner @{PROC}/@{pid}/fd/@{int} w,

        @{PROC}/ r,
        @{PROC}/@{pid}/maps r,
        @{PROC}/@{pid}/stat r,
        @{PROC}/@{pid}/statm r,
        @{PROC}/@{pid}/status r,
  owner @{PROC}/@{pid}/stat r,

  profile crashpad_handler flags=(attach_disconnected,mediate_deleted,complain) {
    include <abstractions/base>
    include <abstractions/nameservice-strict>

    signal (send receive) set=cont peer=@{profile_app}//&@{profile_app}//crashpad_handler,

    unix (send receive) type=seqpacket peer=(label=@{profile_app}),
    unix (send receive) type=stream peer=(label=@{profile_app}),

    /**/*_crashpad_handler mrix,

    owner "@{HOME}/.var/app/@{appid}/**/Crash Reports/**" rwk,

    @{sys}/devices/system/cpu/cpufreq/policy@{int}/scaling_cur_freq r,
    @{sys}/devices/system/cpu/cpufreq/policy@{int}/scaling_max_freq r,

    # Get the ptrace restrictions level
    @{PROC}/sys/kernel/yama/ptrace_scope r,

    owner @{PROC}/@{pid}/fd/ r,
    owner @{PROC}/@{pid}/mem r,
    owner @{PROC}/@{pid}/stat r,
    owner @{PROC}/@{pid}/task/ r,
    owner @{PROC}/@{pid}/task/@{tid}/comm r,

    include if exists <abstractions/flatpak/baseapp/org.chromium.Chromium_crashpad_handler.d>
  }

  include if exists <abstractions/flatpak/baseapp/org.chromium.Chromium.d>

# vim:syntax=apparmor
