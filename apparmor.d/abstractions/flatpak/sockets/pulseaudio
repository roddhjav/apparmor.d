# LOGPROF-SUGGEST: no

  abi <abi/5.0>,

  include <abstractions/sys/input>
  include <abstractions/sys/sound>
  include <abstractions/sys/usb>

  owner @{att}@{run}/user/@{uid}/pipewire-@{int} rw,
  owner @{att}@{run}/user/@{uid}/pulse/native rw,

  owner @{run}/flatpak/pulse/config r,

  @{sys}/class/hidraw/ r,
  @{sys}/class/video4linux/ r,
  @{sys}/devices/platform/uevent r,

  /dev/snd/       r,
  /dev/snd/*      rw,
  /dev/sound/*    rw,

  include if exists <abstractions/flatpak/sockets/pulseaudio.d>

# vim:syntax=apparmor
