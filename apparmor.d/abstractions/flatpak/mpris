# Base rules for mpris

# Based on `abstractions/mpris`, with interface name for flatpak apps.

  abi <abi/5.0>,

  include <abstractions/bus/session/org.mpris.MediaPlayer2.Player>

  # Allow binding to the well-known DBus mpris interface based on the app's name
  # See: https://specifications.freedesktop.org/mpris-spec/latest/
  #aa:dbus own bus=session name=org.mpris.MediaPlayer2.@{name}

  include if exists <abstractions/flatpak/mpris.d>

# vim:syntax=apparmor
