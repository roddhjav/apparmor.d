# Abstraction aggregating user settings files' access needed to full usage of file dialog
#

  abi <abi/5.0>,

  owner @{user_config_dirs}/#@{int} rwk,
  owner @{user_config_dirs}/baloofileinformationrc@{atomic} rwlk, # -> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/kioslaverc r,
  owner @{user_config_dirs}/kiorc r,

  owner @{user_share_dirs}/#@{int} rw,
  owner @{user_share_dirs}/baloo/index r,
  owner @{user_share_dirs}/baloo/index-lock rwk,
  owner @{user_share_dirs}/kfile/ w,
  owner @{user_share_dirs}/kfile/#@{int} rw,
  owner @{user_share_dirs}/kfile/bookmarks.xml{,.bak,.tbcache}@{atomic} rwl, # -> @{user_share_dirs}/kfile/#@{int},
  owner @{user_share_dirs}/user-places.xbel{,.bak,.tbcache}@{atomic} rwl, # -> @{user_share_dirs}/#@{int},

  owner @{user_state_dirs}/#@{int} rwk,
  owner @{user_state_dirs}/kiostaterc@{atomic} rwlk, # -> @{user_state_dirs}/#@{int},

  include if exists <abstractions/kde-file-dialog-settings.d>

# vim:syntax=apparmor
