# Abstraction givin read access to base directories available to the user

  abi <abi/5.0>,

        @{HOMEDIRS}/ r,
  owner @{HOME}/ r,
  owner @{HOME}/[^.]*/{,*/} r,
  owner @{HOME}/[^.]*/.directory r,

        @{MOUNTS}/ r,
  owner @{MOUNTS}/*/{,*/} r,
  owner @{MOUNTS}/*/.directory r,

  include if exists <abstractions/user-dirs-read-strict.d>

# vim:syntax=apparmor
