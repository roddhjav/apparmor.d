# Allow ingress DNS connection

  abi <abi/5.0>,

  include <abstractions/network/tcp>
  include <abstractions/network/udp>

  network bind tcp port=53,
  network (accept listen send receive) tcp port=53,

  network bind udp port=53,
  network (send receive) udp port=53,

  include if exists <abstractions/network/in/domain.d>

# vim:syntax=apparmor
