# Allow ingress IPP (CUPS printing) connection

  abi <abi/5.0>,

  include <abstractions/network/tcp>

  network bind tcp port=631,
  network (accept listen send receive) tcp port=631,

  include if exists <abstractions/network/in/ipp.d>

# vim:syntax=apparmor
