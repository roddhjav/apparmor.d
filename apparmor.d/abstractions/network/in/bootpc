# Allow ingress BOOTPC (DHCP client) connection. The client broadcasts from an
# unconnected socket: the peer port cannot be checked, the local port 68 is.

  abi <abi/5.0>,

  include <abstractions/network/udp>

  network bind udp port=68,
  network (send receive) udp port=68,

  include if exists <abstractions/network/in/bootpc.d>

# vim:syntax=apparmor
