# Allow ingress SSH connection

  abi <abi/5.0>,

  include <abstractions/network/tcp>

  network bind tcp port=22,
  network (accept listen send receive) tcp port=22,

  include if exists <abstractions/network/in/ssh.d>

# vim:syntax=apparmor
