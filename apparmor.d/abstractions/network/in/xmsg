# Allow ingress KDE Connect connection

  abi <abi/5.0>,

  include <abstractions/network/tcp>
  include <abstractions/network/udp>

  network (accept bind listen send receive) tcp port=1716,
  network (bind send receive) udp port=1716,

  include if exists <abstractions/network/in/xmsg.d>

# vim:syntax=apparmor
