# Allow ingress all TCP connection

  abi <abi/5.0>,

  include <abstractions/network/tcp>

  network bind tcp,
  network (accept listen send receive) tcp,

  include if exists <abstractions/network/in/tcp.d>

# vim:syntax=apparmor
