# Local TCP socket operations, shared by the in/ and out/ abstractions.
# Grants neither bind nor connect, so it allows no traffic by itself.

  abi <abi/5.0>,

  network (create getattr getopt setattr setopt shutdown) tcp,

  include if exists <abstractions/network/tcp.d>

# vim:syntax=apparmor
