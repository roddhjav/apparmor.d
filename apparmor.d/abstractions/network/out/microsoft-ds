# Allow egress Microsoft-DS connection (SMB legacy)

  abi <abi/5.0>,

  include <abstractions/network/tcp>

  network (connect send receive) tcp peer=(port=445),

  include if exists <abstractions/network/out/microsoft-ds.d>

