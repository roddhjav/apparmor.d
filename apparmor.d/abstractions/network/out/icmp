# Allow egress ICMP messages (echo request, connectivity checks).
# A raw socket cannot be restricted to a protocol, it requires capability net_raw.

  abi <abi/5.0>,

  network (create getattr getopt setattr setopt shutdown send receive) inet raw,

  include if exists <abstractions/network/out/icmp.d>

# vim:syntax=apparmor
