# Allow egress HTTPS connection

  abi <abi/5.0>,

  include <abstractions/network/tcp>
  include <abstractions/network/udp>

  network (connect send receive) tcp peer=(port=443),
  network (connect send receive) udp peer=(port=443),

  include if exists <abstractions/network/out/https.d>

# vim:syntax=apparmor
