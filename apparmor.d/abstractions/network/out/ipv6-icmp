# Allow egress IPv6-ICMP messages (router solicitation, neighbor discovery).
# A raw socket cannot be restricted to a protocol, it requires capability net_raw.

  abi <abi/5.0>,

  network (create getattr getopt setattr setopt shutdown send receive) inet6 raw,

  include if exists <abstractions/network/out/ipv6-icmp.d>

# vim:syntax=apparmor
