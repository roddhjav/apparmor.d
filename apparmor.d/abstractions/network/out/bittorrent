# Allow egress BitTorrent connection to peers and trackers
# Peers listen on any non privileged port

  abi <abi/5.0>,

  include <abstractions/network/tcp>
  include <abstractions/network/udp>

  network (connect send receive) tcp peer=(port=1024-65535),
  network (connect send receive) udp peer=(port=1024-65535),

  include if exists <abstractions/network/out/bittorrent.d>

# vim:syntax=apparmor
