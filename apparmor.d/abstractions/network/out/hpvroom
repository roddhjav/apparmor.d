# Allow egress HPVROOM connection (port 5228), used by Google push messaging

  abi <abi/5.0>,

  include <abstractions/network/tcp>

  network (connect send receive) tcp peer=(port=5228),

  include if exists <abstractions/network/out/hpvroom.d>

# vim:syntax=apparmor
