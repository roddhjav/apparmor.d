# Netlink client: query the kernel (route, audit...). The netlink protocol
# cannot be restricted, what a profile can change is limited by its capabilities.

  abi <abi/5.0>,

  network (create bind getattr getopt setopt send receive) netlink raw,

  include if exists <abstractions/network/netlink.d>

# vim:syntax=apparmor
