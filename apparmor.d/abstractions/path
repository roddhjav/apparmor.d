# Common directories in $PATH, used by launchers and interactive shells.

  abi <abi/5.0>,

  @{bin}/ r,
  @{bin}/*/ r,
  @{sbin}/ r,
  @{sbin}/*/ r,

  / r,
  /usr/ r,
  /usr/local/ r,
  /usr/local/bin/ r,
  /usr/local/sbin/ r,

  @{user_bin_dirs}/ r,

  /opt/*/bin/ r,
  /snap/bin/ r,
  /var/lib/flatpak/exports/bin/ r,

  include if exists <abstractions/path.d>

# vim:syntax=apparmor
