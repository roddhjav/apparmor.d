# Direct access to the GPU, for compute and monitoring workloads: CUDA, ROCm,
# OpenCL, oneAPI.

  abi <abi/5.0>,

  include <abstractions/graphics>
  include <abstractions/sys/gpumon>

  if "amd" in @{GPU} {
    include <abstractions/amdgpu>
  }

  if "intel" in @{DE} {
    include <abstractions/oneapi>
  }

  /dev/char/@{dynamic}:@{int} w,          # For dynamic assignment range 234 to 254, 384 to 511

  include if exists <abstractions/gpu.d>

# vim:syntax=apparmor
