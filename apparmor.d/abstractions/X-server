  abi <abi/5.0>,

  owner /tmp/.X@{int}-lock rw,

  if "kde" in @{DE} {
    unix (bind listen) type=stream addr=@/tmp/.X11-unix/X@{u8},
    unix (accept send receive) type=stream addr=@/tmp/.X11-unix/X@{u8},

    owner @{run}/user/@{uid}/#@{int} rw,
    owner @{run}/user/@{uid}/xauth_@{rand6} rwl -> @{run}/user/@{uid}/#@{int},

    /tmp/.X11-unix/X@{u8} w,
  }

  if ${WITH_HYPRLAND} {
    /tmp/.X11-unix/X@{u8} w,
  }

  include if exists <abstractions/X-server.d>

# vim:syntax=apparmor
