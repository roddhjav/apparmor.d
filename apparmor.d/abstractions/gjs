# Minimal rules for the GNOME JavaScript interpreter

  abi <abi/5.0>,

  @{bin}/gjs-console rix,

  @{run}/mount/utab r,

  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/mounts r,
  owner @{PROC}/@{pid}/stat r,
  owner @{PROC}/@{pid}/statm r,
  owner @{PROC}/@{pid}/task/@{tid}/stat r,

  include if exists <abstractions/gjs.d>

# vim:syntax=apparmor
