# Allow writing shared settings for Qt-based applications

  abi <abi/5.0>,

  owner @{user_config_dirs}/#@{int} rw,
  owner @{user_config_dirs}/QtProject.@{rand6} rwl, # -> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/QtProject.conf rwl,
  owner @{user_config_dirs}/QtProject.conf.lock rwk,

  include if exists <abstractions/qt-settings-write.d>

# vim:syntax=apparmor
