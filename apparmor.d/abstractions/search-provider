# NEEDS-VARIABLE: provider

# Allow operating as a search provider.
#
# The `@{path}` variable must be defined in the preamble to allow the profile
# to operate as the specified search provider.

  abi <abi/5.0>,

  if "gnome" in @{DE} {
    include <abstractions/bus/session/org.gnome.Shell.SearchProvider2>
  }

  include if exists <abstractions/search-provider.d>

# vim:syntax=apparmor
