# Well known programs used in various development shells. Only programs that are
# safe to allow running from a shell dev environment are allowed here. Profile
# must exist, and may have more permissions than the shell it is coming from.

  abi <abi/5.0>,

  priority=1 @{bin}/aa-log                    Px,
  priority=1 @{bin}/apparmor-language-server  Px,
  priority=1 @{bin}/claude                    Px,
  priority=1 @{bin}/docker                    Px,
  priority=1 @{bin}/dpkg-query                Px,
  priority=1 @{bin}/gh                        Px,
  priority=1 @{bin}/git                       Px,
  priority=1 @{bin}/glab                      Px,
  priority=1 @{bin}/htop                      Px,
  priority=1 @{bin}/ip                        Px, #aa:lint ignore=sbin
  priority=1 @{bin}/journalctl                Px -> child-journalctl-read,
  priority=1 @{bin}/lscpu                     Px,
  priority=1 @{bin}/podman                    Px,
  priority=1 @{bin}/ps                        Px,
  priority=1 @{bin}/ssh                       Px,
  priority=1 @{bin}/top                       Px,
  priority=1 @{bin}/wl-copy                   Px,
  priority=1 @{sbin}/ip                       Px,
  priority=1 @{user_bin_dirs}/apparmor-language-server Px,

  # Well known shells tools
  priority=1 @{bin}/starship PUx,
  priority=1 @{user_cache_dirs}/gitstatus/gitstatusd{,-*} Px,
  priority=1 /usr/share/zsh-theme-powerlevel{9,10}k/gitstatus/usrbin/gitstatusd{,-*} Px,

  include if exists <abstractions/devrun.d>

# vim:syntax=apparmor
