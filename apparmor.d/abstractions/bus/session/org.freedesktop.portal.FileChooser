  abi <abi/5.0>,

  # portal.FileChooser

  dbus send bus=session path=/org/freedesktop/portal/desktop
       interface=org.freedesktop.portal.FileChooser
       member={SaveFile,OpenFile}
       peer=(label=xdg-desktop-portal),

  include if exists <abstractions/bus/session/org.freedesktop.portal.FileChooser.d>

# vim:syntax=apparmor
