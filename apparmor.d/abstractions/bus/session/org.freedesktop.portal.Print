  abi <abi/5.0>,

  dbus send bus=session path=/org/freedesktop/portal/desktop
       interface=org.freedesktop.portal.Print
       member={PreparePrint,Print}
       peer=(name=@{busname}, label=xdg-desktop-portal),

  include if exists <abstractions/bus/session/org.freedesktop.portal.Print.d>

# vim:syntax=apparmor
