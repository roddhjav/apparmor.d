  abi <abi/5.0>,

  # portal.Documents

  dbus send bus=session path=/org/freedesktop/portal/documents
       interface=org.freedesktop.portal.Documents
       member=GetMountPoint
       peer=(name=org.freedesktop.portal.Documents, label=xdg-document-portal),

  include if exists <abstractions/bus/session/org.freedesktop.portal.Documents.d>

# vim:syntax=apparmor
