  abi <abi/5.0>,

  dbus receive bus=session path=/org/freedesktop/portal/desktop
       interface=org.freedesktop.impl.portal.Inhibit
       member=StateChanged
       peer=(name=@{busname}, label=xdg-desktop-portal-gtk),

  dbus send bus=session path=/org/freedesktop/portal/desktop
       interface=org.freedesktop.impl.portal.Inhibit
       member=CreateMonitor
       peer=(name=@{busname}, label=xdg-desktop-portal-gtk),

  include if exists <abstractions/bus/session/org.freedesktop.impl.portal.Inhibit.d>

# vim:syntax=apparmor
