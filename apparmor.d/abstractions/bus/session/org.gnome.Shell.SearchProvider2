# NEEDS-VARIABLE: path

  abi <abi/5.0>,

  #aa:dbus see bus=session name=org.gnome.Shell.SearchProvider2 label=gnome-shell

  dbus receive bus=session path=@{path}/SearchProvider
       interface=org.gnome.Shell.SearchProvider2
       member={GetInitialResultSet,GetSubsearchResultSet,GetResultMetas}
       peer=(name=@{busname}, label=gnome-shell),

  dbus receive bus=session path=@{path}/SearchProvider
       interface=org.gnome.Shell.SearchProvider2
       member=*Cancel
       peer=(name=@{busname}, label=gnome-shell),

  dbus receive bus=session path=@{path}/SearchProvider
       interface=org.gnome.Shell.SearchProvider2
       member=ActivateResult
       peer=(name=@{busname}, label=gnome-shell),

  include if exists <abstractions/bus/session/org.gnome.Shell.SearchProvider2.d>

# vim:syntax=apparmor

