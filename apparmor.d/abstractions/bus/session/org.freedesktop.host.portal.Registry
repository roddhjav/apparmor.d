  abi <abi/5.0>,

  # portal.Registry

  dbus send bus=session path=/org/freedesktop/portal/desktop
       interface=org.freedesktop.host.portal.Registry
       member=Register
       peer=(label=xdg-desktop-portal),

  include if exists <abstractions/bus/session/org.freedesktop.host.portal.Registry.d>

# vim:syntax=apparmor
