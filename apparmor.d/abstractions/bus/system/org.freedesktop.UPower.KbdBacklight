  abi <abi/5.0>,

  # UPower.KbdBacklight

  dbus send bus=system path=/org/freedesktop/UPower/KbdBacklight
       interface=org.freedesktop.UPower.KbdBacklight
       member={GetBrightness,GetMaxBrightness}
       peer=(name=@{busname}, label="@{p_upowerd}"),

  dbus send bus=session path=/org/freedesktop/UPower/KbdBacklight
       interface=org.freedesktop.UPower.KbdBacklight
       member={GetBrightness,GetMaxBrightness}
       peer=(name=@{busname}, label="@{p_upowerd}"),

  include if exists <abstractions/bus/system/org.freedesktop.UPower.KbdBacklight.d>

# vim:syntax=apparmor
