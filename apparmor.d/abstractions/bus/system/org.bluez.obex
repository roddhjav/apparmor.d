  abi <abi/5.0>,

  #aa:dbus see bus=system name=org.bluez.obex label=obexd

  dbus send bus=session path=/org/bluez/obex
       interface=org.freedesktop.DBus.Properties
       member=GetAll
       peer=(name=@{busname}, label=obexd),

  include if exists <abstractions/bus/system/org.bluez.obex.d>

# vim:syntax=apparmor
