  abi <abi/5.0>,

  dbus send bus=system path=/org/bluez/hci0
       interface=org.bluez.Adapter1
       member={StartDiscovery,StopDiscovery}
       peer=(name=@{busname}, label=bluetoothd),

  include if exists <abstractions/bus/system/org.bluez.Adapter1.d>

# vim:syntax=apparmor
