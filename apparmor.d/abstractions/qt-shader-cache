  abi <abi/5.0>,

  owner @{sddm_cache_dirs}/ w,
  owner @{sddm_cache_dirs}/qtshadercache/ rw,
  owner @{sddm_cache_dirs}/qtshadercache/#@{int} rw,
  owner @{sddm_cache_dirs}/qtshadercache/@{hex} rwl,
  owner @{sddm_cache_dirs}/qtshadercache-@{arch}-big_endian-lp64/ rw,
  owner @{sddm_cache_dirs}/qtshadercache-@{arch}-big_endian-lp64/@{hex}.@{rand6} rwl,
  owner @{sddm_cache_dirs}/qtshadercache-@{arch}-big_endian-lp64/#@{int} rw,
  owner @{sddm_cache_dirs}/qtshadercache-@{arch}-little_endian-lp64/ rw,
  owner @{sddm_cache_dirs}/qtshadercache-@{arch}-little_endian-lp64/@{hex}.@{rand6} rwl,
  owner @{sddm_cache_dirs}/qtshadercache-@{arch}-little_endian-lp64/#@{int} rw,

  owner @{user_cache_dirs}/ w,
  owner @{user_cache_dirs}/qtshadercache/ rw,
  owner @{user_cache_dirs}/qtshadercache/#@{int} rw,
  owner @{user_cache_dirs}/qtshadercache/@{hex} rwl,
  owner @{user_cache_dirs}/qtshadercache-@{arch}-big_endian-lp64/ rw,
  owner @{user_cache_dirs}/qtshadercache-@{arch}-big_endian-lp64/@{hex}.@{rand6} rwl,
  owner @{user_cache_dirs}/qtshadercache-@{arch}-big_endian-lp64/#@{int} rw,
  owner @{user_cache_dirs}/qtshadercache-@{arch}-little_endian-lp64 rw,
  owner @{user_cache_dirs}/qtshadercache-@{arch}-little_endian-lp64/@{hex}.@{rand6} rwl,
  owner @{user_cache_dirs}/qtshadercache-@{arch}-little_endian-lp64/#@{int} rw,

  include if exists <abstractions/qt-shader-cache.d>

# vim:syntax=apparmor
