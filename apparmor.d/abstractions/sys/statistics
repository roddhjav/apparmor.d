# Statistics for network throughput graph (bytes, packets, errors, collisions per interface).

  abi <abi/5.0>,

  @{sys}/devices/**/net/*/statistics/collisions r,
  @{sys}/devices/**/net/*/statistics/rx_bytes r,
  @{sys}/devices/**/net/*/statistics/rx_errors r,
  @{sys}/devices/**/net/*/statistics/rx_packets r,
  @{sys}/devices/**/net/*/statistics/tx_bytes r,
  @{sys}/devices/**/net/*/statistics/tx_errors r,
  @{sys}/devices/**/net/*/statistics/tx_packets r,

  include if exists <abstractions/sys/statistics.d>

# vim:syntax=apparmor
