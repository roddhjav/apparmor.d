  abi <abi/5.0>,

  # Allow access to all cards
  /dev/dri/ r,
  /dev/dri/card@{int} rw,

  # Video Acceleration API
  /dev/dri/renderD128 rw,
  /dev/dri/renderD129 rw,

  include if exists <abstractions/dev/dri.d>

