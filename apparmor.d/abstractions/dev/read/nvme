# SSD Nvme devices

  abi <abi/5.0>,

  # Controller char device (identify, smart)
  /dev/nvme@{int} r,

  /dev/@{nvme} rk,
  /dev/@{nvme}p@{u8} rk,

  include if exists <abstractions/dev/read/nvme.d>

# vim:syntax=apparmor
