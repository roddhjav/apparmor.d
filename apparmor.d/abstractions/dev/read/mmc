# SD card devices

  abi <abi/5.0>,

  /dev/mmcblk@{u8} rk,
  /dev/mmcblk@{u8}boot[01] rk,
  /dev/mmcblk@{u8}p@{u8} rk,
  /dev/mmcblk@{u8}rpmb rk,

  include if exists <abstractions/dev/read/mmc.d>

# vim:syntax=apparmor
