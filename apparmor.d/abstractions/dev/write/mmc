# SD card devices

  abi <abi/5.0>,

  include <abstractions/dev/read/mmc>

  /dev/mmcblk@{u8} w,
  /dev/mmcblk@{u8}boot[01] w,
  /dev/mmcblk@{u8}p@{u8} w,
  /dev/mmcblk@{u8}rpmb w,

  include if exists <abstractions/dev/write/mmc.d>

# vim:syntax=apparmor
