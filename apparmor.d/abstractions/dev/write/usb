  abi <abi/5.0>,

  include <abstractions/dev/read/usb>

  @{PROC}/tty/drivers r,

  /dev/bus/usb/@{d}@{d}@{d}/@{d}@{d}@{d} wk,

  # Allow access to all ttyUSB devices too
  /dev/ttyACM@{int} wk,
  /dev/ttyUSB@{int} wk,

  # Allow raw access to USB printers (i.e. for receipt printers in POS systems).
  /dev/usb/lp@{int} wk,

  include if exists <abstractions/dev/write/usb.d>

# vim:syntax=apparmor
