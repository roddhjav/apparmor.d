# SSD Nvme devices

  abi <abi/5.0>,

  include <abstractions/dev/read/nvme>

  @{sys}/devices/@{pci}/nvme/nvme@{u8}/@{nvme}/@{nvme}p@{u8}/uevent w,

  /dev/@{nvme} w,
  /dev/@{nvme}p@{u8} w,

  include if exists <abstractions/dev/write/nvme.d>

# vim:syntax=apparmor
