abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/aa-mode
profile aa-mode @{exec_path} {
  include <abstractions/base>
  include <abstractions/golang-strict>

  capability dac_read_search,

  @{exec_path} mr,

  @{sbin}/ r,
  @{sbin}/apparmor_parser  Px,

  /etc/apparmor.d/{,**} rw,

  include if exists <local/aa-mode>
}

# vim:syntax=apparmor
