abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/aa-log
profile aa-log @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/golang-strict>
  include <abstractions/nameservice-strict>

  capability dac_read_search,

  @{exec_path} mr,

  @{bin}/journalctl  Px -> child-journalctl-read,

  /usr/share/tcltk/{,**} r,

  @{log}/audit/* r,
  @{log}/syslog* r,

  @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/user@@{uid}.service/*.scope/cpu.max r,

  /dev/tty@{u8} rw,

  include if exists <local/aa-log>
}

# vim:syntax=apparmor
