abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/nproc
profile nproc @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/cgroup-limits>
  include <abstractions/consoles>

  @{exec_path} mr,

  # file_inherit
  deny network netlink raw,
  deny owner @{user_config_dirs}/** rw,
  deny /dev/ptmx rw,

  include if exists <local/nproc>
}

# vim:syntax=apparmor
