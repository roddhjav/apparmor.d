abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/lslogins
profile lslogins @{exec_path} {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  @{etc_ro}/login.defs r,
  /etc/.pwd.lock wk,
  /etc/shadow r,

  @{log}/lastlog r,
  @{log}/wtmp rk,

  @{PROC}/ r,

  include if exists <local/lslogins>
}

# vim:syntax=apparmor
