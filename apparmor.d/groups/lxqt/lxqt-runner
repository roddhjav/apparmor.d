abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/lxqt-runner
profile lxqt-runner @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/lxqt>

  ptrace read peer=lxqt-session,

  @{exec_path} mr,

  owner @{user_config_dirs}/lxqt/lxqt-runner.conf.lock rwk,
  owner @{user_config_dirs}/lxqt/#@{int} rw,
  owner @{user_config_dirs}/lxqt/lxqt-runner.conf.@{rand6} rwlk  -> @{user_config_dirs}/lxqt/#@{int},

  owner /tmp/@{int} r,

  /dev/tty rw,

  include if exists <local/lxqt-runner>
}

# vim:syntax=apparmor
