abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/kwalletmanager{5,6}
profile kwalletmanager @{exec_path} {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/common/kde>
  include <abstractions/consoles>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/nameservice-strict>
  include <abstractions/qt-compose-cache-write>
  include <abstractions/qt-settings-write>
  include <abstractions/user-download-strict>

  @{exec_path} mr,

  /etc/fstab r,
  /etc/xdg/ui/ui_standards.rc r,

  owner @{user_config_dirs}/kwalletrc@{atomic} rwlk -> @{user_config_dirs}/#@{int},

        @{PROC}/@{pid}/mountinfo r,
        @{PROC}/@{pid}/mounts r,
  owner @{PROC}/@{pid}/cmdline r,

  /dev/shm/#@{int} rw,

  include if exists <local/kwalletmanager>
}

# vim:syntax=apparmor
