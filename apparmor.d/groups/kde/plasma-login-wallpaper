abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/plasma-login-wallpaper
profile plasma-login-wallpaper @{exec_path} {
  include <abstractions/base>
  include <abstractions/common/kde>

  @{exec_path} mr,

  @{bin}/ r,

  /usr/share/plasma/{,**} r,
  /usr/share/wallpapers/{,**} r,

  @{etc_ro}/login.defs r,
  /etc/plasmalogin.conf r,

  owner @{SDDM_HOME}/wallpapers/* r,

  owner @{sddm_cache_dirs}/plasma-login-wallpaper/ rw,
  owner @{sddm_cache_dirs}/plasma-login-wallpaper/** rwlk,

  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/task/@{tid}/comm w,

  include if exists <local/plasma-login-wallpaper>
}

# vim:syntax=apparmor
