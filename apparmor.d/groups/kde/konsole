abi <abi/5.0>,

include <tunables/global>

@{export_ext} = shortcuts pdf txt

@{exec_path} = @{bin}/konsole
profile konsole @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/bus-session>
  include <abstractions/common/kde>
  include <abstractions/consoles>
  include <abstractions/deny-home-dotfiles>
  include <abstractions/kde-export-settings>
  include <abstractions/nameservice-strict>

  if "kde" in @{DE} {
    include <abstractions/kde-file-dialog>
  }

  if "gnome" in @{DE} {
    include <abstractions/gnome-file-dialog>
  }

  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  ptrace read,

  signal send,

  #aa:dbus own bus=session name=org.kde.konsole-@{int}

  @{exec_path} mr,

  @{bin}/net      Px,
  @{bin}/testparm Px,

  @{lib}/libheif/                            r,
  @{lib}/libheif/**                         mr,
  @{lib}/{,@{multiarch}/}utempter/utempter  Px,

  # The shell is not confined on purpose.
  @{bin}/@{shells}            Ux,

  # Some CLI program can be launched directly from KDE
  @{browsers_path}            Px,
  @{bin}/btop                PUx,
  @{bin}/htop                 Px,
  @{bin}/micro               PUx,
  @{bin}/nvtop                Px,
  @{bin}/vim                  Ux,

  #aa:exec kioworker

  /usr/share/desktop-directories/kf5-*.directory r,
  /usr/share/kf6/{,**} r,

  /etc/cups/client.conf r,
  /etc/exports r,
  /etc/fstab r,
  /etc/xdg/dolphinrc r,
  /etc/xdg/konsolerc r,
  /etc/xdg/kshorturifilterrc r,
  /etc/xdg/menus/{,**} r,
  /etc/xdg/ui/ui_standards.rc r,

  owner @{HOME}/@{XDG_SSH_DIR}/config r,

  owner @{user_config_dirs}/kbookmarkrc r,
  owner @{user_config_dirs}/kio_httprc r,
  owner @{user_config_dirs}/konsole.notifyrc@{atomic} rwlk,
  owner @{user_config_dirs}/konsolesshconfig@{atomic} rwlk,
  owner @{user_config_dirs}/kservicemenurc r,
  owner @{user_config_dirs}/kuriikwsfilterrc r,
  owner @{user_config_dirs}/Kvantum/{,**} r,
  owner @{user_config_dirs}/menus/{,**} r,
  owner @{user_config_dirs}/session/** rwlk,

  owner @{user_share_dirs}/user-places.xbel r,

  owner @{tmp}/#@{int} rw,
  owner @{tmp}/@{hex12}@{h} rw,
  owner @{tmp}/konsole.@{rand6} rw,

        @{run}/mount/utab r,

  owner @{run}/user/@{uid}/#@{int} rw,
  owner @{run}/user/@{uid}/konsole@{rand6}.@{int}.kioworker.socket rwl -> @{run}/user/@{uid}/#@{int},

  owner @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/user@@{uid}.service/app.slice/app-org.kde.konsole-@{int}.scope/** rw,

        @{PROC}/@{pids}/task/@{tid}/children r,
        @{PROC}/@{pids}/cmdline r,
        @{PROC}/@{pids}/stat r,
        @{PROC}/@{pids}/status r,
  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/environ r,
  owner @{PROC}/@{pid}/mountinfo r,

  /dev/ptmx rw,

  # Silencing requests for printing
  deny network inet stream,
  deny network inet6 stream,

  include if exists <local/konsole>
}

# vim:syntax=apparmor
