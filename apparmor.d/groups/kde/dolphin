abi <abi/5.0>,

include <tunables/global>

@{export_ext} = shortcuts pdf

@{exec_path} = @{bin}/dolphin
profile dolphin @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/app-launcher-user>
  include <abstractions/audio-client>
  include <abstractions/bus/system/org.freedesktop.UDisks2>
  include <abstractions/common/kde>
  include <abstractions/consoles>
  include <abstractions/deny-sensitive-home>
  include <abstractions/devices-usb>
  include <abstractions/disks-read>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/kde-export-settings>
  include <abstractions/nameservice-strict>
  include <abstractions/recent-documents-write>
  include <abstractions/ssl_certs>
  include <abstractions/thumbnails-cache-write>

  if "kde" in @{DE} {
    include <abstractions/kde-file-dialog>
  }

  if "gnome" in @{DE} {
    include <abstractions/gnome-file-dialog>
  }

  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  signal send set=hup peer=@{p_systemd},
  signal send set=term peer=kioworker,

  ptrace read peer=@{p_systemd},
  ptrace read peer=okular,

  #aa:dbus own bus=session name=org.freedesktop.FileManager1
  #aa:dbus own bus=session name=org.kde.dolphin-@{int}

  #aa:dbus talk bus=session name=org.kde.ActivityManager path=/ActivityManager{,/**} label=kactivitymanagerd

  @{exec_path} mr,

  @{lib}/libheif/            r,
  @{lib}/libheif/*.so*      mr,

  priority=1 @{ldd_path} rix,

  @{bin}/lsb_release  rPx,
  @{bin}/net          Px,
  @{bin}/testparm     Px,
  @{thunderbird_path} rPx,

  #aa:exec kioworker
  #aa:exec utempter

  /usr/share/kf5/kmoretools/{,**} r,
  /usr/share/kf6/purpose/{,*} r,
  /usr/share/kio/{,**} r,
  /usr/share/konsole/{,**} r,
  /usr/share/kservices{5,6}/{,**} r,
  /usr/share/kservicetypes5/{,**} r,
  /usr/share/misc/termcap r,
  /usr/share/templates/{,*.desktop} r,
  /usr/share/thumbnailers/{,**} r,

  /etc/exports r,
  /etc/fstab r,
  /etc/xdg/arkrc r,
  /etc/xdg/dolphinrc r,
  /etc/xdg/ui/ui_standards.rc r,

  /var/lib/samba/usershare/ r,

  #aa:lint ignore=too-wide
  # Full access to user's data
  / r,
  /*/ r,
  @{bin}/ r,
  @{lib}/ r,
  @{MOUNTDIRS}/ r,
  @{MOUNTS}/ r,
  @{MOUNTS}/** rw,
  owner @{HOME}/{,**} rw,
  owner @{run}/user/@{uid}/{,**} rw,
  owner @{tmp}/{,**} rw,

  # Silence non user's data
  deny @{efi}/{,**} r,
  deny /opt/{,**} r,
  deny /root/{,**} r,
  deny /tmp/.* rw,
  deny /tmp/.*/{,**} rw,

  owner @{user_cache_dirs}/ksplash/qmlcache/* rwl -> @{user_cache_dirs}/dolphin/qmlcache/#@{int},

  owner @{user_config_dirs}/baloofileinformationrc@{atomic} lk -> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/kiorc@{atomic} lk -> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/kservicemenurc@{atomic} lk -> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/ktrashrc@{atomic} lk -> @{user_config_dirs}/#@{int},
  owner @{user_config_dirs}/knfsshare@{atomic} rwk,
  owner @{user_config_dirs}/libaccounts-glib/accounts.db* k,
  owner @{user_config_dirs}/session/#@{int} rwk,
  owner @{user_config_dirs}/session/dolphin_dolphin_dolphin.@{rand6} rwl -> @{user_config_dirs}/session/#@{int},

  owner @{user_share_dirs}/baloo/index-lock k,
  owner @{user_share_dirs}/kactivitymanagerd/resources/database{,-shm} k,
  owner link @{user_share_dirs}/user-places.xbel* -> @{user_share_dirs}/#@{int},

  owner @{tmp}/#@{int} rwk,
  owner @{tmp}/dolphin.@{rand6} rwl -> @{tmp}/#@{int},
  owner @{tmp}/dolphin.@{rand6}.@{rand6} l -> @{tmp}/#@{int},
  owner @{tmp}/dolphin.@{rand6}.lock rwk,

        @{run}/issue r,
        @{run}/mount/utab r,
  owner @{run}/user/@{uid}/#@{int} rw,
  owner @{run}/user/@{uid}/dolphin@{rand6}.@{int}.kioworker.socket rwl -> @{run}/user/@{uid}/#@{int},

  @{run}/udev/data/+*:* r,                # Identifies all subsystems
  @{run}/udev/data/c@{int}:@{int} r,      # Identifies all character devices

  @{sys}/bus/ r,
  @{sys}/bus/*/devices/ r,
  @{sys}/class/*/ r,
  @{sys}/devices/**/uevent r,

  owner @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/user@@{uid}.service/app.slice/app-org.kde.dolphin-@{int}.scope/cgroup.controllers r,
  owner @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/user@@{uid}.service/app.slice/app-org.kde.dolphin-@{int}.scope/cgroup.subtree_control w,
  owner @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/user@@{uid}.service/app.slice/app-org.kde.dolphin-@{int}.scope/main.scope/ w,
  owner @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/user@@{uid}.service/app.slice/app-org.kde.dolphin-@{int}.scope/main.scope/cgroup.procs w,
  owner @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/user@@{uid}.service/app.slice/app-org.kde.dolphin-@{int}.scope/tab(@{int}).scope/ w,
  owner @{sys}/fs/cgroup/user.slice/user-@{uid}.slice/user@@{uid}.service/app.slice/app-org.kde.dolphin-@{int}.scope/tab(@{int}).scope/cgroup.procs w,

        @{PROC}/@{pids}/task/@{tid}/children r,
  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/cmdline r,
  owner @{PROC}/@{pid}/fdinfo/@{int} r,
  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/mounts r,
  owner @{PROC}/@{pid}/stat r,

  /dev/ptmx rw,

  # Silencing requests for printing
  deny network inet stream,
  deny network inet6 stream,

  include if exists <local/dolphin>
}

# vim:syntax=apparmor
