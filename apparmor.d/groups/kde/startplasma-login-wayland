abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/startplasma-login-wayland
profile startplasma-login-wayland @{exec_path} {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/bus-system>
  include <abstractions/bus/system/org.freedesktop.locale1>
  include <abstractions/mime>
  include <abstractions/qt>

  signal receive set=term peer=plasmalogin-helper,

  @{exec_path} mr,

  @{bin}/xrdb Px,

  /usr/share/color-schemes/{,**} r,
  /usr/share/plasma/look-and-feel/{,**} r,

  /etc/xdg/menus/{,**} r,

  owner @{sddm_cache_dirs}/ w,
  owner @{sddm_cache_dirs}/#@{int} rwk,
  owner @{sddm_cache_dirs}/ksycoca{5,6}_* rwlk -> @{sddm_cache_dirs}/#@{int},

  owner @{sddm_config_dirs}/ w,
  owner @{sddm_config_dirs}/* rwlk,
  owner @{sddm_config_dirs}/kdedefaults/ w,
  owner @{sddm_config_dirs}/kdedefaults/* rwlk,

  owner @{tmp}/#@{int} rw,
  owner @{tmp}/startplasma-login-wayland.@{rand6} w,
  owner link @{tmp}/startplasma-login-wayland.@{rand6} -> @{tmp}/#@{int},

  @{PROC}/sys/kernel/random/boot_id r,
  owner @{PROC}/@{pid}/mountinfo r,

  /dev/tty rw,
  /dev/tty@{u8} rw,

  include if exists <local/startplasma-login-wayland>
}

# vim:syntax=apparmor
