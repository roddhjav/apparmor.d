abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/plasma-emojier
profile plasma-emojier @{exec_path} {
  include <abstractions/base>
  include <abstractions/common/kde>
  include <abstractions/nameservice-strict>

  @{exec_path} mr,

  /usr/share/plasma/emoji/*.dict r,

  owner @{user_cache_dirs}/plasma.emojier/ rw,
  owner @{user_cache_dirs}/plasma.emojier/** rwlk,

  owner @{user_config_dirs}/plasma.emojierrc@{atomic} rwlk -> @{user_config_dirs}/#@{int},

  owner @{user_state_dirs}/plasma.emojierstaterc@{atomic} rwlk -> @{user_state_dirs}/#@{int},

  include if exists <local/plasma-emojier>
}

# vim:syntax=apparmor
