abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/plasma-shutdown
profile plasma-shutdown @{exec_path} {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/bus-system>

  @{exec_path} mr,

  #aa:exec plasma-fallback-session-save

  /usr/share/qt6/translations/* r,

  owner @{user_config_dirs}/kdedefaults/kdeglobals r,
  owner @{user_config_dirs}/kdeglobals r,
  owner @{user_config_dirs}/ksmserverrc r,
  owner @{user_config_dirs}/plasma-workspace/shutdown/ r,

  include if exists <local/plasma-shutdown>
}

# vim:syntax=apparmor
