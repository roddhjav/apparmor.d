abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/plasma-keyboard
profile plasma-keyboard @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/common/kde>
  include <abstractions/nameservice-strict>
  include <abstractions/sys/dmi>

  signal receive set=term peer=kwin_wayland,

  @{exec_path} mr,

  @{bin}/ r,

  /usr/share/hunspell/* r,
  /usr/share/plasma/desktoptheme/** r,
  /usr/share/plasma/keyboard/{,**} r,

  owner @{sddm_cache_dirs}/ksvg-elements r,
  owner @{sddm_cache_dirs}/plasma_theme_default.kcache rw,

  owner @{sddm_config_dirs}/qtvirtualkeyboard/ w,

  owner @{user_cache_dirs}/ksvg-elements@{atomic} rwlk,
  owner @{user_cache_dirs}/*.kcache rw,

  owner @{user_config_dirs}/plasmakeyboardrc r,
  owner @{user_config_dirs}/qtvirtualkeyboard/ w,

  owner @{user_share_dirs}/plasma/desktoptheme/** r,

        @{PROC}/sys/kernel/random/boot_id r,
  owner @{PROC}/@{pid}/task/@{tid}/comm w,

              /dev/tty r,
  owner @{att}/dev/tty@{u8} rw,

  include if exists <local/plasma-keyboard>
}

# vim:syntax=apparmor
