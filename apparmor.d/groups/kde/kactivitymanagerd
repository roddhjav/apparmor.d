abi <abi/5.0>,

include <tunables/global>

@{exec_path}  =  @{lib}/kactivitymanagerd
@{exec_path} += @{lib}/@{multiarch}/{,libexec/}kactivitymanagerd
profile kactivitymanagerd @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/devices-usb>
  include <abstractions/graphics>
  include <abstractions/kde-strict>
  include <abstractions/ibus-strict>
  include <abstractions/nameservice-strict>
  include <abstractions/recent-documents-write>
  include <abstractions/thumbnails-cache-read>
  include <abstractions/user-read-strict>

  #aa:dbus own bus=session name=org.kde.ActivityManager path=/ActivityManager
  #aa:dbus own bus=session name=org.kde.runners.activities

  #aa:dbus talk bus=session name=org.kde.kglobalaccel path=/kglobalaccel label=kwin_wayland

  @{exec_path} mr,

  /etc/xdg/menus/{,*/} r,
  /usr/share/kf{5,6}/kactivitymanagerd/{,**} r,
  /usr/share/kservices{5,6}/{,**} r,

  owner @{user_desktop_dirs}/ r,
  owner @{user_desktop_dirs}/*.desktop r,

  owner @{user_config_dirs}/breezerc r,
  owner @{user_config_dirs}/kactivitymanagerdrc@{atomic} rwlk,
  owner @{user_config_dirs}/libreoffice/**.xcu r,
  owner @{user_config_dirs}/menus/{,**} r,

  owner @{user_share_dirs}/kactivitymanagerd/{,**} rwlk,
  owner @{user_share_dirs}/kservices{5,6}/{,**} r,
  owner @{user_share_dirs}/user-places.xbel r,

  owner @{user_state_dirs}/kactivitymanagerdstaterc@{atomic} rwlk,

  owner @{tmp}/kmail2.@{rand6} r,

  @{run}/mount/utab r,

  owner @{run}/user/@{uid}/#@{int} rw,
  owner @{run}/user/@{uid}/*@{rand6}.*.socket rwl -> @{run}/user/@{uid}/#@{int},

  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/mounts r,

  /dev/tty r,

  include if exists <local/kactivitymanagerd>
}

# vim:syntax=apparmor
