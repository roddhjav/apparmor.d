abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/kf6/kameleon-qmk-helper
profile kameleon-qmk-helper @{exec_path} {
  include <abstractions/base>
  include <abstractions/bus-system>
  include <abstractions/devices-usb-read>

  #aa:dbus own bus=system name==org.kde.kameleon.qmk.helper

  @{exec_path} mr,

  @{sys}/class/hidraw/ r,
  @{sys}/devices/@{pci}/uevent r,
  @{sys}/devices/@{pci_bus}/uevent r,
  @{sys}/fs/cgroup/system.slice/cpu.max r,
  @{sys}/fs/cgroup/system.slice/system-dbus**org.kde.kameleon.qmk.helper.slice/cpu.max r,

  @{PROC}/@{pid}/cgroup r,

  include if exists <local/kameleon-qmk-helper>
}

# vim:syntax=apparmor
