abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/sddm-greeter{,-qt6}
profile sddm-greeter @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/audio-client>
  include <abstractions/bus/system/org.freedesktop.login1>
  include <abstractions/common/kde>
  include <abstractions/consoles>
  include <abstractions/fontconfig-cache-write>
  include <abstractions/nameservice-strict>
  include <abstractions/qt-compose-cache-write>
  include <abstractions/upower-observe>
  include <abstractions/sys/dmi>

  network netlink raw,

  ptrace read peer=plasmashell, # used for theme preview

  signal receive set=term peer=sddm,

  dbus send bus=system path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member=ListActivatableNames
       peer=(name=org.freedesktop.DBus, label="@{p_dbus_system}"),

  dbus send bus=session path=/VirtualKeyboard
       interface=org.freedesktop.DBus.Properties
       member=Get
       peer=(name=org.kde.KWin, label=kwin_wayland),

  @{exec_path} mr,

  @{lib}/libheif/ r,
  @{lib}/libheif/*.so* rm,

  /usr/share/endeavouros/backgrounds/** r,
  /usr/share/hunspell/** r,
  /usr/share/plasma/desktoptheme/** r,
  /usr/share/sddm/{,**} r,
  /usr/share/wallpapers/{,**} r,
  /usr/share/wayland-sessions/{,*.desktop} r,
  /usr/share/xsessions/{,*.desktop} r,

  /etc/fstab r,
  /etc/os-release r,
  /etc/sddm.conf r,
  /etc/sddm.conf.d/{,*} r,
  @{etc_ro}/vdpau_wrapper.cfg r,

  / r,
  @{bin}/ r,

  /var/lib/AccountsService/icons/* r,

        @{SDDM_HOME}/state.conf r,
  owner @{SDDM_HOME}/** rw,
  owner @{SDDM_HOME}/#@{int} mrw,

  owner @{sddm_cache_dirs}/ksvg-elements@{atomic} rwlk,

  @{HOME}/.face.icon r,

  owner @{user_cache_dirs}/ rw,
  owner @{user_cache_dirs}/ksvg-elements@{atomic} rwlk,
  owner @{user_cache_dirs}/plasma_theme_*.kcache rw,
  owner @{user_cache_dirs}/plasma-svgelements@{atomic} rw,
  owner @{user_cache_dirs}/sddm-greeter{,-qt6}/{,**} rwl,

  owner @{user_config_dirs}/qtvirtualkeyboard/ w,

  # If one is blocked, the others are probed.
  deny owner @{HOME}/#@{int} mrw,
       owner @{HOME}/.glvnd* mrw,

  owner @{tmp}/runtime-sddm/ rw,
  owner @{tmp}/sddm--@{rand6} rw,
  owner @{tmp}/sddm-:@{int}-@{rand6} rw,

  owner @{run}/sddm/{,*} rw,

  owner @{PROC}/@{pid}/cmdline r,
  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/mounts r,
  owner @{PROC}/@{pid}/task/@{tid}/comm w,

  include if exists <local/sddm-greeter>
}

# vim:syntax=apparmor
