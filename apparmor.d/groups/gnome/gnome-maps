abi <abi/5.0>,

include <tunables/global>

@{domain} = org.gnome.Maps
@{path} = org/gnome/Maps

@{exec_path} = @{bin}/gnome-maps /usr/share/gnome-maps/org.gnome.Maps
profile gnome-maps @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/common/gnome>
  include <abstractions/nameservice-strict>
  include <abstractions/network/netlink>
  include <abstractions/network/out/domain>
  include <abstractions/network/out/https>
  include <abstractions/p11-kit>
  include <abstractions/ssl_certs>

  #aa:dbus own bus=session name=org.gnome.Maps

  @{exec_path} mr,

  @{open_path}  rPx -> child-open-help,

  @{bin}/gjs-console r,

  owner @{user_pictures_dirs}/** rw,

  owner @{user_cache_dirs}/shumate/ rw,
  owner @{user_cache_dirs}/shumate/** rwlk,

  owner @{user_config_dirs}/shumate/ rw,
  owner @{user_config_dirs}/shumate/** rwlk,

  owner @{user_share_dirs}/shumate/ rw,
  owner @{user_share_dirs}/shumate/** rwlk,

  @{run}/mount/utab r,

  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/mounts r,
  owner @{PROC}/@{pid}/task/@{tid}/stat r,

  include if exists <local/gnome-maps>
}

# vim:syntax=apparmor
