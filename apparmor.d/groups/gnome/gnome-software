abi <abi/5.0>,

include <tunables/global>

@{domain} = org.gnome.Software
@{path} = /org/gnome/Software

@{exec_path} = @{bin}/gnome-software
profile gnome-software @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/accounts-observe>
  include <abstractions/bus/session/org.freedesktop.portal.Documents>
  include <abstractions/bus/system/org.freedesktop.locale1>
  include <abstractions/bus/system/org.freedesktop.PolicyKit1>
  include <abstractions/bus/system/org.freedesktop.RealtimeKit1>
  include <abstractions/common/gnome>
  include <abstractions/flatpak/store>
  include <abstractions/fontconfig-cache-write>
  include <abstractions/nameservice-strict>
  include <abstractions/network-manager-observe>
  include <abstractions/p11-kit>
  include <abstractions/search-provider>
  include <abstractions/ssl_certs>
  include <abstractions/upower-observe>

  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  signal send set=kill peer=fbwrap,
  signal send set=kill peer=flatpak//bwrap,
  signal send set=kill peer=flatpak//apps,

  unix type=stream, # peer=(label=---),
  unix type=stream peer=(label=fbwrap),

  #aa:dbus own bus=session name=org.freedesktop.PackageKit
  #aa:dbus own bus=session name=org.gnome.Software

  #aa:dbus talk bus=system name=org.freedesktop.fwupd path=/ label=fwupd
  #aa:dbus talk bus=system name=org.freedesktop.PackageKit path=/{,**} label="@{p_packagekitd}"
  #aa:dbus talk bus=system name=org.freedesktop.sysupdate1 label=systemd-sysupdate

  #aa:dbus talk bus=session name=org.freedesktop.Flatpak.SystemHelper label=flatpak-session-helper
  #aa:dbus talk bus=session name=org.gnome.Epiphany.WebAppProvider label=epiphany-webapp-provider

  dbus send bus=session path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member=ReloadConfig
       peer=(name=org.freedesktop.DBus, label="@{p_systemd_user}"),

  @{exec_path} mrix,

  @{open_path}                rPx -> child-open,
  @{bin}/baobab               rPx,
  @{bin}/gnome-control-center rPx,

  @{lib}/gnome-software-restarter rix,

  /usr/share/app-info/{,**} r,
  /usr/share/appdata/{,**} r,
  /usr/share/byobu/desktop/{,**} r,
  /usr/share/metainfo/{,**} r,
  /usr/share/swcatalog/{,**} r,
  /usr/share/xml/iso-codes/{,**} r,

  /etc/appstream.conf r,
  /etc/PackageKit/Vendor.conf r,
  /etc/pulse/client.conf r,

  /var/cache/app-info/icons/**.png r,
  /var/cache/app-info/xmls/{,**} r,
  /var/cache/swcatalog/xml/{,**} r,
  /var/cache/swcatalog/icons/{,**} r,

  /var/lib/apt/lists/*.yml.gz r,

  /var/lib/PackageKit/offline-update-competed r,
  /var/lib/PackageKit/prepared-update r,
  /var/lib/swcatalog/** r,

  owner @{user_download_dirs}/*.flatpakref r,

  owner @{user_config_dirs}/pulse/*.conf r,

  owner @{user_share_dirs}/ r,

  owner @{tmp}/#@{int} rw,

  owner @{run}/user/@{uid}/.dbus-proxy/ rw,
  owner @{run}/user/@{uid}/.dbus-proxy/a11y-bus-proxy-@{rand6} rw,
  owner @{run}/user/@{uid}/.dbus-proxy/session-bus-proxy-@{rand6} rw,
  owner @{run}/user/@{uid}/.dbus-proxy/system-bus-proxy-@{rand6} rw,
  owner @{run}/user/@{uid}/app/{,*/} rw,
  owner @{run}/user/@{uid}/systemd/private rw,

  owner /dev/shm/flatpak-com.*/ rw,
  owner /dev/shm/flatpak-com.*/* rw,

  @{att}@{run}/systemd/inhibit/@{int}.ref rw,
  @{run}/systemd/sessions/@{int} r,
  @{run}/systemd/users/@{uid} r,

        @{PROC}/@{pids}/mounts r,
        @{PROC}/1/cgroup r,
        @{PROC}/modules r,
        @{PROC}/sys/fs/pipe-max-size r,
  owner @{PROC}/@{pid}/fdinfo/@{int} r,

  include if exists <local/gnome-software>
}

# vim:syntax=apparmor
