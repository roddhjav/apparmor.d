#aa:lint ignore=too-wide

# *Part of the `systemd` (as PID 1) profile.*
#
# `sd` is a profile for **s**ystem**d**-executor run as root. It is used to
# run all service files and to encapsulate stacked service profiles (hence the
# short name). By design, this profile must be as broad as all the profiles it
# runs combined.
#
# It aims to reduce the size of the `systemd` profile.
#
# !!! note
#
#     To reduce the number of artificially stacked profiles, this profile is
#     currently **not used** in FSP mode, as `systemd` purposely runs
#     systemd-executor unconfined.
#

abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/systemd-executor
profile sd flags=(unconfined,attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  @{exec_path} mr,

  #aa:lint ignore=transition
  @{bin}/**                                      mpix,
  @{sbin}/**                                     mpix,
  @{lib}/**                                       pix,
  /etc/cron.*/*                                   pix,
  /etc/init.d/*                                   pix,
  /etc/update-motd.d/*                            pix,
  /usr/share/*/**                                 pix,

  # Systemd user: systemd --user
  @{lib}/systemd/systemd                           px -> systemd-user,

  # Unit services using systemctl
  @{bin}/systemctl                                 Cx -> systemctl,

  # Unit services
  @{bin}/kill                                      Cx -> kill,

  profile systemctl flags=(attach_disconnected,mediate_deleted,complain) {
    include <abstractions/base>
    include <abstractions/app/systemctl>

    capability net_admin,

    include if exists <usr/sd_systemctl.d>
    include if exists <local/sd_systemctl>
  }

  profile kill flags=(attach_disconnected,mediate_deleted,complain) {
    include <abstractions/base>

    signal send,

    @{bin}/kill mr,

    include if exists <local/sd_kill>
  }

  include if exists <usr/sd.d>
  include if exists <local/sd>
}

# vim:syntax=apparmor
