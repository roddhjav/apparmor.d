abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,gvfs/}gvfsd-smb
profile gvfsd-smb @{exec_path} {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/dconf-write>
  include <abstractions/gvfs-backend>
  include <abstractions/gschemas>
  include <abstractions/mime>
  include <abstractions/nameservice-strict>
  include <abstractions/network/netlink>
  include <abstractions/network/out/domain>
  include <abstractions/network/out/microsoft-ds>

  unix type=stream addr=none peer=(label=nautilus),

  @{exec_path} mr,

  @{etc_ro}/krb5.conf r,
  /etc/krb5.conf.d/{,**} r,
  /etc/samba/smb.conf r,

        @{run}/avahi-daemon/socket rw,
  owner @{run}/samba/ w,
  owner @{run}/user/@{uid}/gvfsd/socket-@{rand8} rw,

  include if exists <local/gvfsd-smb>
}

# vim:syntax=apparmor
