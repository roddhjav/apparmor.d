abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/xfce4-sensors
profile xfce-sensors @{exec_path} {
  include <abstractions/base>
  include <abstractions/xfce>
  include <abstractions/sys/hwmon-temp>
  include <abstractions/sys/i2c>
  include <abstractions/sys/power-supply>

  @{exec_path} mr,

  @{sys}/class/thermal/ r,
  @{sys}/devices/virtual/thermal/thermal_zone@{int}/temp r,

  include if exists <local/xfce-sensors>
}

# vim:syntax=apparmor
