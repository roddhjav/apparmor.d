abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,gnupg/}keyboxd
profile keyboxd @{exec_path} {
  include <abstractions/base>
  include <abstractions/consoles>

  @{exec_path} mr,

  owner @{user_gpg_dirs}/ w,
  owner @{user_gpg_dirs}/common.conf r,
  owner @{user_gpg_dirs}/keyboxd.conf r,
  owner @{user_gpg_dirs}/public-keys.d/ rw,
  owner @{user_gpg_dirs}/public-keys.d/* rwlk,

  owner @{run}/user/@{uid}/gnupg/S.keyboxd rw,

  owner @{PROC}/@{pid}/fd/ r,

  include if exists <local/keyboxd>
}

# vim:syntax=apparmor
