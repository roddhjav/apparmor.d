abi <abi/5.0>,

include <tunables/global>

@{lib_dirs} = @{user_share_dirs}/torbrowser/tbb/@{arch}/tor-browser/Browser/ @{HOME}/.tb/tor-browser/Browser/
@{data_dirs} = @{lib_dirs}/TorBrowser/Data/

@{exec_path} = @{lib_dirs}/TorBrowser/Tor/tor
profile torbrowser-tor @{exec_path} {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/ssl_certs>

  network inet stream,
  network netlink raw,

  @{exec_path} mr,

  @{lib_dirs}/{,**}                                    r,
  @{lib_dirs}/TorBrowser/Tor/*.so*                     m,
  @{lib_dirs}/TorBrowser/Tor/PluggableTransports/**  rcx -> pluggable-transports,

  owner @{data_dirs}/Tor/ rw,
  owner @{data_dirs}/Tor/** rw,
  owner @{data_dirs}/Tor/lock rwk,

  /tmp/onionshare/** rw,  # OnionShare compatibility

  @{PROC}/sys/kernel/random/uuid r,
  @{PROC}/sys/net/core/somaxconn r,

  signal receive set=(term kill) peer=torbrowser,

  deny /etc/group r,
  deny /etc/host.conf r,
  deny /etc/hosts r,
  deny /etc/machine-id r,
  deny /etc/mailcap r,
  deny /etc/nsswitch.conf r,
  deny /etc/os-release r,
  deny /etc/passwd r,
  deny /etc/resolv.conf r,
  deny /etc/services r,
  deny /var/lib/dbus/machine-id r,

  profile pluggable-transports {
    include <abstractions/base>
    include <abstractions/golang>
    include <abstractions/nameservice-strict>
    include <abstractions/ssl_certs>

    network inet dgram,
    network inet stream,
    network inet6 dgram,
    network inet6 stream,
    network netlink raw,

    @{lib_dirs}/TorBrowser/Tor/PluggableTransports/** mr,

    owner @{data_dirs}/Tor/pt_state/{,**} rw,

    @{PROC}/sys/net/core/somaxconn r,

    signal receive set=(term kill) peer=torbrowser-tor,

    include if exists <local/torbrowser-tor_pluggable-transports>
  }

  include if exists <local/torbrowser-tor>
}

# vim:syntax=apparmor
