abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/systemd-boot-check-no-failures
profile systemd-boot-check-no-failures @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>

  @{exec_path} mr,

  include if exists <local/systemd-boot-check-no-failures>
}

# vim:syntax=apparmor
