abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/systemd-cryptenroll
profile systemd-cryptenroll @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>

  @{exec_path} mr,

  include if exists <local/systemd-cryptenroll>
}

# vim:syntax=apparmor

