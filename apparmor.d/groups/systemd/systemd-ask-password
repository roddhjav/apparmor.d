abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/systemd-ask-password
profile systemd-ask-password @{exec_path} {
  include <abstractions/base>
  include <abstractions/consoles>

  @{exec_path} mr,

  @{run}/systemd/ask-password/ r,
  @{run}/systemd/ask-password/.#ask.@{hex} rw,
  @{run}/systemd/ask-password/ask.@{int}@{int} w,
  @{run}/systemd/ask-password/sck.@{hex} w,

  owner @{PROC}/@{pid}/stat r,

  include if exists <local/systemd-ask-password>
}

# vim:syntax=apparmor
