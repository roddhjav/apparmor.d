abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/systemd-growfs
profile systemd-growfs @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/disks-write>
  include <abstractions/common/systemd>

  capability net_admin,
  capability sys_admin,
  capability sys_resource,

  @{exec_path} mr,

  /home/ r,

  @{run}/ r,
  @{run}/cryptsetup/ r,
  @{run}/cryptsetup/L_254:@{int} rwk,         # for /dev/zram*

  @{PROC}/devices r,

  include if exists <local/systemd-growfs>
}

# vim:syntax=apparmor
