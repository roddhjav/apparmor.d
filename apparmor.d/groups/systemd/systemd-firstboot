abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/systemd-firstboot
profile systemd-firstboot @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>

  all,

  @{exec_path} mr,

  include if exists <local/systemd-firstboot>
}

# vim:syntax=apparmor
