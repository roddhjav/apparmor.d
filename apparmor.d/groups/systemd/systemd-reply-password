abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/systemd-reply-password
profile systemd-reply-password @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>

  @{exec_path} mr,

  @{run}/systemd/ask-password/sck.@{hex16} w,

  include if exists <local/systemd-reply-password>
}

# vim:syntax=apparmor
