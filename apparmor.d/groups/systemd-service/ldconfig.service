# systemd service: `ldconfig.service`
#
# ```sh
# /sbin/ldconfig -X
# ```
#

abi <abi/5.0>,

include <tunables/global>

profile ldconfig.service {
  include <abstractions/base>

  @{lib}/ r,
  @{sbin}/ldconfig  r,

  /opt/**/lib{,32,64}/ r,

  /etc/tunables.conf r,
  /etc/tunables.conf.d/{,*} r,

  /var/cache/ldconfig/aux-cache rw,
  /var/cache/ldconfig/aux-cache~ rw,

  include if exists <local/ldconfig.service>
}

# vim:syntax=apparmor
