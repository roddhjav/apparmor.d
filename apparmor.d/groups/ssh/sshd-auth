abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{lib}/{openssh,ssh}/sshd-auth
profile sshd-auth @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>
  include <abstractions/network/netlink>
  include <abstractions/network/udp>

  capability dac_override,
  capability setgid,
  capability setuid,
  capability sys_chroot,

  # Pre-auth phase: only use the connected socket inherited from sshd-session
  network (getattr getopt setopt send receive shutdown) tcp port=22,

  unix type=stream peer=(label=sshd-session),

  @{exec_path} mr,
  @{sbin}/sshd.hmac r,

  /etc/gss/mech.d/{,*} r,

  include if exists <local/sshd-auth>
}

# vim:syntax=apparmor
