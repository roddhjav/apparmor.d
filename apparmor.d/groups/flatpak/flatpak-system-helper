abi <abi/5.0>,

include <tunables/global>

@{appid} = @{word}.@{word}.@{word}{,.@{word}}

@{exec_path} = @{lib}/flatpak-system-helper
profile flatpak-system-helper @{exec_path} flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/accounts-observe>
  include <abstractions/bus-system>
  include <abstractions/bus/system/org.freedesktop.PolicyKit1>
  include <abstractions/mime>
  include <abstractions/nameservice-strict>
  include <abstractions/p11-kit>
  include <abstractions/ssl_certs>

  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability fowner,
  capability net_admin,
  capability setgid,
  capability setuid,
  capability sys_nice,
  capability sys_ptrace,

  network inet6 dgram,

  ptrace read,

  unix (send receive) type=seqpacket peer=(label=dbus-system),
  unix (send receive) type=seqpacket peer=(label=flatpak),
  unix (send receive) type=seqpacket peer=(label=flatpak-fusermount),
  unix (send receive) type=seqpacket peer=(label=flatpak-revokefs-fuse),
  unix (send receive) type=seqpacket peer=(label=unconfined),
  # Stores
  unix (send receive) type=seqpacket peer=(label=bazaar),
  unix (send receive) type=seqpacket peer=(label=gnome-software),
  unix (send receive) type=seqpacket peer=(label=plasma-discover),

  #aa:dbus own bus=system name=org.freedesktop.Flatpak.SystemHelper

  @{exec_path} mr,

  if ${WITH_FLATPAKAPPS} {
    #aa:only abi>=5
    # Patched flatpak: transition to the flatpak.install and flatpak.trigger
    @{bin}/bwrap           Cx -> bwrap_apps,

  } else {
    # Default flatpak: bwrap handle flatpak install and trigger commands.
    @{bin}/bwrap           Cx -> bwrap,

  }

  @{bin}/gpg{,2}           Px -> flatpak-gpg,
  @{bin}/gpgconf           Px -> flatpak-gpg,
  @{bin}/gpgsm             Px -> flatpak-gpg,
  @{lib}/revokefs-fuse    rix,

  /etc/flatpak/{,**} r,
  /etc/machine-id r,

  /usr/share/flatpak/remotes.d/{,**} r,
  /usr/share/flatpak/triggers/ r,

  /var/lib/flatpak/{,**} rwlk,
  /var/tmp/flatpak-cache-*/{,**} rw,

  owner /{var/,}tmp/#@{int} rw,
  owner /{var/,}tmp/ostree-gpg-@{rand6}/ rw,
  owner @{tmp}/ostree-gpg-@{rand6}/** rwlk -> /tmp/ostree-gpg-@{rand6}/**,

  @{tmp}/remote-summary-sig.@{rand6} r,
  @{tmp}/remote-summary.@{rand6} r,

  @{sys}/devices/system/node/ r,

        @{PROC}/@{pids}/cgroup r,
        @{PROC}/@{pids}/stat r,
        @{PROC}/@{pids}/status r,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/fdinfo/@{int} r,

  profile bwrap_apps flags=(attach_disconnected) {
    include <abstractions/base>
    include <abstractions/bwrap>
    include <abstractions/consoles>

    capability dac_override,
    capability dac_read_search,
    capability sys_resource,

    change_profile -> flatpak.install,
    change_profile -> flatpak.trigger,

    /app/.ref rk,
    /usr/.ref rk,

    owner /bindfile@{rand6} rw,

    owner /tmp/#@{int} rw,

    include if exists <local/flatpak-system-helper_bwrap_apps>
  }

  profile bwrap flags=(attach_disconnected) {
    include <abstractions/base>
    include <abstractions/bwrap>
    include <abstractions/nameservice-strict>

    capability dac_override,
    capability dac_read_search,
    capability sys_resource,

    /app/bin/*    rix,

    @{bin}/bsdtar  ix,
    @{bin}/cp      ix,
    @{bin}/gzip    ix,
    @{bin}/install ix,
    @{bin}/mv      ix,
    @{bin}/rm      ix,
    @{bin}/sed     ix,
    @{bin}/tar     ix,
    @{bin}/xz      ix,

    @{bin}/gtk{,4}-update-icon-cache  Px -> flatpak-system-helper//bwrap//&gtk-update-icon-cache,
    @{bin}/update-desktop-database    Px -> flatpak-system-helper//bwrap//&update-desktop-database,
    @{bin}/update-mime-database       Px -> flatpak-system-helper//bwrap//&update-mime-database,

    /usr/share/flatpak/triggers/desktop-database.trigger ix,
    /usr/share/flatpak/triggers/gtk-icon-cache.trigger   ix,
    /usr/share/flatpak/triggers/mime-database.trigger    ix,

    @{system_share_dirs}/** r,
    @{system_share_dirs}/*ubuntu/applications/.mimeinfo.cache.@{rand6} rw,
    @{system_share_dirs}/*ubuntu/applications/mimeinfo.cache w,
    @{system_share_dirs}/applications/.mimeinfo.cache.@{rand6} w,
    @{system_share_dirs}/applications/intent.cache w,
    @{system_share_dirs}/applications/intent.cache.@{rand6} w,
    @{system_share_dirs}/applications/mimeinfo.cache w,
    @{system_share_dirs}/applications/mimeinfo.cache.@{rand6} w,
    @{system_share_dirs}/icons/**/.icon-theme.cache rw,
    @{system_share_dirs}/icons/**/icon-theme.cache w,
    @{system_share_dirs}/icons/hicolor/index.theme w,
    @{system_share_dirs}/mime/{,**} w,

    @{user_share_dirs}/** r,
    @{user_share_dirs}/.mimeinfo.cache.@{rand6} w,
    @{user_share_dirs}/**/.icon-theme.cache w,
    @{user_share_dirs}/**/icon-theme.cache w,
    @{user_share_dirs}/applications/.mimeinfo.cache.@{rand6} w,
    @{user_share_dirs}/applications/intent.cache w,
    @{user_share_dirs}/applications/intent.cache.@{rand6} w,
    @{user_share_dirs}/applications/mimeinfo.cache w,
    @{user_share_dirs}/applications/mimeinfo.cache.@{rand6} w,
    @{user_share_dirs}/icons/hicolor/index.theme w,
    @{user_share_dirs}/mime/{,**} w,
    @{user_share_dirs}/mimeinfo.cache w,

    /app/extra/** rw,
    /bindfile@{rand6} rw,
    /usr/.ref rk,

    /tmp/#@{int} rw,

    /dev/tty rw,

    include if exists <local/flatpak-system-helper_bwrap>
  }

  include if exists <local/flatpak-system-helper>
}

# vim:syntax=apparmor
