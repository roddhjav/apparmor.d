# aa-install completion

_aa-install() {
	COMPREPLY=()
	local cur="${COMP_WORDS[COMP_CWORD]}"
	local args=(
		-s --status
		-l --list
		-i --install
		-a --all
		-c --complain
		-e --enforce
		-u --uninstall
		--no-reload
		--config --magic --src
		-h --help
	)
	local lastarg="${COMP_WORDS[$COMP_CWORD-1]}"
	case "$lastarg" in
	--config | --magic | --src)
		COMPREPLY+=($(compgen -o dirnames -A directory -- ${cur}))
		;;
	*)
		COMPREPLY+=($(compgen -W "${args[*]}" -- ${cur}))
		;;
	esac
}

complete -F _aa-install aa-install
